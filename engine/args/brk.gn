# Pinned GN arguments for BrkCore. configure.sh copies this file to out/Brk/args.gn. See engine/README.md for why.

# Release code, one framework file (same shape as ArcCore), not official: no LTO and no PGO, which would need far more
# memory and time than an 8-core machine with 16 GB has for a build that runs beside other work.
is_debug = false
is_component_build = false
is_official_build = false
chrome_pgo_phase = 0
use_thin_lto = false
target_cpu = "arm64"

# No debug info in Chromium's own code: much less disk and link memory. brk/ turns on its own (minimal_symbols).
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_dsyms = false
dcheck_always_on = false

# One link at a time: a framework link takes several GB.
concurrent_links = 1

# No remote compile.
use_remoteexec = false
# Plain ninja, so the build tool can be paused alone (engine/tools/paced-build.py).
use_siso = false

# H.264 and AAC, as Arc and Chrome play them; many sites need them (the user's decision, 2026-11-08). This build is local and not
# distributed: publishing it would need a licensing check first (engine/README.md). Confirm with engine/tools/codec-probe.py.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# Widevine needs Google's signed component, which a self-built Chromium cannot get (the user's decision: off).
enable_widevine = false

# No Google API keys of any kind.
use_official_google_api_keys = false

# Not Chromium's list of experiments for its test bots (testing/variations/fieldtrial_testing_config.json), which builds that are not
# Google's official ones turn on at startup: it showed a "Search with Chromium" icon in the menu bar (OmniboxEverywhere) and turns on
# hundreds of unfinished features. Chrome and CEF run without it.
disable_fieldtrial_testing_config = true
