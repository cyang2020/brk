+#ifndef BRK_BROWSER_BRK_DIALOG_HOST_H_
+#define BRK_BROWSER_BRK_DIALOG_HOST_H_
+
+#import <AppKit/AppKit.h>
+
+#include <memory>
+#include <set>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/web_modal/web_contents_modal_dialog_host.h"
+#include "ui/views/widget/widget.h"
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}
+
+namespace brkcore {
+
+class BrkDialogHost;
+
+// Where Chromium puts the dialogs it attaches to a page: passkeys, HTTP sign-in, print preview, "Page unresponsive",
+// FedCM, payment and certificate pickers. Chrome hangs them on its Views browser window; a Brk window is a plain
+// NSWindow, so each Brk window gets one Views widget for them to hang on: a transparent window over the Brk window
+// that takes no clicks, made its child only while a dialog uses it (and only once that window is on screen in the
+// current Space), so it moves with the window and is otherwise off screen. It is also the window's "primary window
+// widget" (BrowserElementsViews), which Chromium's tab dialogs (TabDialogManager) require.
+//
+// Each page has one host for its whole life (BrkPageDialogHost, kept on the WebContents), bound to the window it is
+// in: a tab moved to another window takes its host and its dialogs along, as Chrome's do. Dialogs centre on their
+// page, as Chrome centres them on its contents area.
+class BrkDialogHosts {
+ public:
+  explicit BrkDialogHosts(BrowserWindowInterface* browser);
+  BrkDialogHosts(const BrkDialogHosts&) = delete;
+  BrkDialogHosts& operator=(const BrkDialogHosts&) = delete;
+  ~BrkDialogHosts();
+
+  // The Brk window the dialogs belong to; nil while the window is going.
+  void SetNativeWindow(NSWindow* window);
+  void WindowDidBecomeKey();
+  void WindowDidResignKey();
+
+  // Never null: Chromium dereferences what it gets. `contents` nil means the window as a whole. A page's host is
+  // bound to this window from now on.
+  web_modal::WebContentsModalDialogHost* HostFor(content::WebContents* contents);
+
+  // For the hosts.
+  views::Widget* widget() const { return widget_.get(); }
+  NSWindow* native_window() const { return window_; }
+  base::WeakPtr<BrkDialogHosts> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+  void Bind(BrkDialogHost* host);
+  void Unbind(BrkDialogHost* host);
+  // `window`: the window of the page whose dialog is coming; the widget becomes its child.
+  void ObserversAdded(int count, NSWindow* window);
+  void ObserversRemoved(int count);
+
+ private:
+  void Attach(NSWindow* parent);
+  void WaitFor(NSWindow* parent);
+  void Detach();
+  void DetachIfUnused();
+  void PlaceWidget();
+  void StopWatchingParent();
+  void NotifyPositionsChanged();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  __weak NSWindow* window_ = nil;
+  // The window the widget is a child of while shown.
+  __weak NSWindow* parent_ = nil;
+  std::unique_ptr<views::Widget> widget_;
+  std::unique_ptr<BrkDialogHost> window_host_;
+  // The hosts bound to this window; each unbinds itself before it goes or moves.
+  std::set<raw_ptr<BrkDialogHost>> bound_;
+  // Watchers across the bound hosts; the widget is shown while any exist.
+  int observers_ = 0;
+  bool shown_ = false;
+  bool destroying_ = false;
+  // Notification tokens for the parent (resize, move, close) or the window waited for (WaitFor).
+  NSMutableArray* parent_watchers_ = [[NSMutableArray alloc] init];
+  NSMutableArray* workspace_watchers_ = [[NSMutableArray alloc] init];
+  // Held while the Brk window is key: Chromium shows a tab dialog as the key window only when its host widget paints
+  // as active (TabDialogManager::ShowDialog), as Chrome's browser widget does while its window is key.
+  std::unique_ptr<views::Widget::PaintAsActiveLock> paint_as_active_;
+  base::WeakPtrFactory<BrkDialogHosts> weak_factory_{this};
+};
+
+}  // namespace brkcore
+
+#endif  // BRK_BROWSER_BRK_DIALOG_HOST_H_
