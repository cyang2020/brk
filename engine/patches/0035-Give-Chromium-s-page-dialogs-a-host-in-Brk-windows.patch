+++ b/brk/browser/brk_dialog_host.mm
@@ -0,0 +1,440 @@
+#import "brk/browser/brk_dialog_host.h"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/observer_list.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/interaction/browser_elements_views.h"
+#include "chrome/browser/ui/views/interaction/browser_elements_views_impl.h"
+#include "components/web_modal/modal_dialog_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#import "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace brkcore {
+
+// A dialog host bound to one window's BrkDialogHosts. Dialogs centre on the page (`PageView`), their top at its top
+// edge, as Chrome centres a tab dialog on its contents area below the toolbar; the window-level host has no page.
+class BrkDialogHost : public web_modal::WebContentsModalDialogHost {
+ public:
+  BrkDialogHost() = default;
+  BrkDialogHost(const BrkDialogHost&) = delete;
+  BrkDialogHost& operator=(const BrkDialogHost&) = delete;
+  ~BrkDialogHost() override { Shutdown(); }
+
+  // The host now serves `hosts`' window; its watchers, and the dialogs they place, move with it.
+  void BindTo(BrkDialogHosts* hosts) {
+    if (hosts_.get() == hosts) {
+      return;
+    }
+    if (BrkDialogHosts* old = hosts_.get()) {
+      old->ObserversRemoved(observer_count_);
+      old->Unbind(this);
+    }
+    hosts_ = hosts ? hosts->GetWeakPtr() : nullptr;
+    if (hosts) {
+      hosts->Bind(this);
+      if (observer_count_ > 0) {
+        hosts->ObserversAdded(observer_count_, Window());
+      }
+    }
+  }
+
+  // web_modal::ModalDialogHost:
+  gfx::NativeView GetHostView() const override {
+    views::Widget* widget = hosts_ ? hosts_->widget() : nullptr;
+    return widget ? widget->GetNativeView() : gfx::NativeView();
+  }
+  gfx::Point GetDialogPosition(const gfx::Size& size) override {
+    const gfx::Rect window = WindowBoundsInScreen();
+    const gfx::Rect page = PageBoundsInScreen();
+    int x = page.x() + (page.width() - size.width()) / 2;
+    x = std::max(window.x(), std::min(x, window.right() - size.width()));
+    // Chromium adds the host widget's screen origin back (constrained_window's and TabDialogManager's
+    // GetModalDialogBounds), so the answer is relative to it.
+    views::Widget* widget = hosts_ ? hosts_->widget() : nullptr;
+    const gfx::Point origin = widget ? widget->GetClientAreaBoundsInScreen().origin() : window.origin();
+    return gfx::Point(x - origin.x(), page.y() - origin.y());
+  }
+  bool ShouldActivateDialog() const override {
+    NSWindow* window = Window();
+    return window && NSApp.active && (window.keyWindow || window.mainWindow);
+  }
+  void AddObserver(web_modal::ModalDialogHostObserver* observer) override {
+    observers_.AddObserver(observer);
+    ++observer_count_;
+    FollowPage();
+    if (hosts_) {
+      hosts_->ObserversAdded(1, Window());
+    }
+  }
+  void RemoveObserver(web_modal::ModalDialogHostObserver* observer) override {
+    if (!observers_.HasObserver(observer)) {
+      return;
+    }
+    observers_.RemoveObserver(observer);
+    --observer_count_;
+    if (observer_count_ == 0) {
+      StopFollowingPage();
+    }
+    if (hosts_) {
+      hosts_->ObserversRemoved(1);
+    }
+  }
+  void NotifyPositionRequiresUpdate() override {
+    observers_.Notify(&web_modal::ModalDialogHostObserver::OnPositionRequiresUpdate);
+  }
+
+  // web_modal::WebContentsModalDialogHost: the window's width (Chrome allows the whole contents container) and the
+  // height from the dialog's top to the window's bottom.
+  gfx::Size GetMaximumDialogSize() override {
+    const gfx::Rect window = WindowBoundsInScreen();
+    const gfx::Rect page = PageBoundsInScreen();
+    return gfx::Size(window.width(), std::max(0, window.bottom() - page.y()));
+  }
+
+ protected:
+  virtual NSView* PageView() const { return nil; }
+
+  // The ModalDialogHost contract: every watcher hears OnHostDestroying before the host goes; they remove themselves.
+  // A subclass calls this first in its destructor, while its page is still reachable.
+  void Shutdown() {
+    if (shut_down_) {
+      return;
+    }
+    shut_down_ = true;
+    StopFollowingPage();
+    observers_.Notify(&web_modal::ModalDialogHostObserver::OnHostDestroying);
+    BindTo(nullptr);
+  }
+
+ private:
+  // The Brk window this host's Browser belongs to. A page moving to another window still sits in the old window's
+  // view tree for a moment (CoreEngine's handoff), so its view's window is only the fallback, for a Browser not told
+  // its window yet.
+  NSWindow* Window() const {
+    if (NSWindow* window = hosts_ ? hosts_->native_window() : nil) {
+      return window;
+    }
+    return PageView().window;
+  }
+
+  gfx::Rect WindowBoundsInScreen() const {
+    NSWindow* window = Window();
+    if (!window) {
+      return gfx::Rect(0, 0, 800, 600);
+    }
+    return gfx::ScreenRectFromNSRect([window convertRectToScreen:window.contentLayoutRect]);
+  }
+
+  // The page's view where the shell shows it; the window when the page is not on screen in this window.
+  gfx::Rect PageBoundsInScreen() const {
+    NSWindow* window = Window();
+    NSView* view = PageView();
+    if (!window || !view || view.window != window || view.hiddenOrHasHiddenAncestor || NSIsEmptyRect(view.bounds)) {
+      return WindowBoundsInScreen();
+    }
+    return gfx::ScreenRectFromNSRect([window convertRectToScreen:[view convertRect:view.bounds toView:nil]]);
+  }
+
+  // While a dialog uses this host, a page resized by the shell (the sidebar shown or hidden, a split changing) moves
+  // its dialog back to the page's centre. Window moves and resizes are the hosts' (NotifyPositionsChanged).
+  void FollowPage() {
+    NSView* view = PageView();
+    if (frame_observer_ || !view) {
+      return;
+    }
+    view.postsFrameChangedNotifications = YES;
+    BrkDialogHost* host = this;
+    frame_observer_ = [NSNotificationCenter.defaultCenter addObserverForName:NSViewFrameDidChangeNotification
+                                                                      object:view
+                                                                       queue:nil
+                                                                  usingBlock:^(NSNotification*) {
+                                                                    host->NotifyPositionRequiresUpdate();
+                                                                  }];
+  }
+
+  void StopFollowingPage() {
+    if (frame_observer_) {
+      [NSNotificationCenter.defaultCenter removeObserver:frame_observer_];
+      frame_observer_ = nil;
+    }
+  }
+
+  base::WeakPtr<BrkDialogHosts> hosts_;
+  base::ObserverList<web_modal::ModalDialogHostObserver> observers_;
+  int observer_count_ = 0;
+  bool shut_down_ = false;
+  // Removed before this host goes (Shutdown), so the block's raw `this` never outlives it.
+  id frame_observer_ = nil;
+};
+
+// A page's host lives as long as its WebContents, whichever window shows it.
+class BrkPageDialogHost : public BrkDialogHost, public content::WebContentsUserData<BrkPageDialogHost> {
+ public:
+  ~BrkPageDialogHost() override { Shutdown(); }
+
+ protected:
+  // WebContents::GetNativeView is not const; reading the view changes nothing.
+  NSView* PageView() const override {
+    return const_cast<BrkPageDialogHost*>(this)->GetWebContents().GetNativeView().GetNativeNSView();
+  }
+
+ private:
+  friend class content::WebContentsUserData<BrkPageDialogHost>;
+  explicit BrkPageDialogHost(content::WebContents* contents)
+      : content::WebContentsUserData<BrkPageDialogHost>(*contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BrkPageDialogHost);
+
+BrkDialogHosts::BrkDialogHosts(BrowserWindowInterface* browser) : browser_(browser) {
+  widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                   views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.name = "BrkDialogHost";
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.accept_events = false;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.bounds = gfx::Rect(0, 0, 1, 1);
+  widget_->Init(std::move(params));
+  views::View* root = widget_->SetContentsView(std::make_unique<views::View>());
+  NSWindow* ns_window = widget_->GetNativeWindow().GetNativeNSWindow();
+  // Never a window of its own to the person: not in Mission Control, the Window menu or Cmd+`.
+  ns_window.collectionBehavior |= NSWindowCollectionBehaviorTransient | NSWindowCollectionBehaviorIgnoresCycle;
+  ns_window.excludedFromWindowsMenu = YES;
+  ns_window.hasShadow = NO;
+  ns_window.ignoresMouseEvents = YES;
+  // Chromium's tab dialogs take the host from the browser's primary window widget; Chrome's BrowserView registers it.
+  if (BrowserElementsViews* elements = BrowserElementsViews::From(browser)) {
+    if (auto* impl = elements->AsA<BrowserElementsViewsImpl>()) {
+      impl->Init(root);
+    }
+  }
+}
+
+BrkDialogHosts::~BrkDialogHosts() {
+  destroying_ = true;
+  // Pages still bound (their tabs closed after this, or moving) lose this window; their next window binds them again.
+  weak_factory_.InvalidateWeakPtrs();
+  bound_.clear();
+  // The window-level host's watchers hear OnHostDestroying before the widget they hang on goes.
+  std::unique_ptr<BrkDialogHost> window_host = std::move(window_host_);
+  window_host.reset();
+  paint_as_active_.reset();
+  StopWatchingParent();
+  if (widget_) {
+    widget_->CloseNow();
+    widget_.reset();
+  }
+}
+
+void BrkDialogHosts::SetNativeWindow(NSWindow* window) {
+  if (window == window_) {
+    return;
+  }
+  window_ = window;
+  paint_as_active_.reset();
+  if (window && window.isKeyWindow) {
+    WindowDidBecomeKey();
+  }
+  // A dialog that came before the window, or one whose Browser moved, goes to this window. With no window left the
+  // widget leaves the old one now, before that window closes.
+  if (!window) {
+    Detach();
+  } else if (observers_ > 0) {
+    Attach(window);
+  }
+}
+
+void BrkDialogHosts::WindowDidBecomeKey() {
+  if (widget_ && !paint_as_active_) {
+    paint_as_active_ = widget_->LockPaintAsActive();
+  }
+}
+
+void BrkDialogHosts::WindowDidResignKey() {
+  paint_as_active_.reset();
+}
+
+web_modal::WebContentsModalDialogHost* BrkDialogHosts::HostFor(content::WebContents* contents) {
+  BrkDialogHost* host = nullptr;
+  if (!contents) {
+    if (!window_host_) {
+      window_host_ = std::make_unique<BrkDialogHost>();
+    }
+    host = window_host_.get();
+  } else {
+    host = BrkPageDialogHost::GetOrCreateForWebContents(contents);
+  }
+  host->BindTo(this);
+  return host;
+}
+
+void BrkDialogHosts::Bind(BrkDialogHost* host) {
+  bound_.insert(host);
+}
+
+void BrkDialogHosts::Unbind(BrkDialogHost* host) {
+  bound_.erase(host);
+}
+
+void BrkDialogHosts::NotifyPositionsChanged() {
+  // A copy: a watcher placing its dialog may bind or unbind a host.
+  std::vector<BrkDialogHost*> hosts;
+  for (const raw_ptr<BrkDialogHost>& host : bound_) {
+    hosts.push_back(host.get());
+  }
+  for (BrkDialogHost* host : hosts) {
+    if (bound_.contains(host)) {
+      host->NotifyPositionRequiresUpdate();
+    }
+  }
+}
+
+void BrkDialogHosts::ObserversAdded(int count, NSWindow* window) {
+  observers_ += count;
+  Attach(window ?: window_);
+}
+
+void BrkDialogHosts::ObserversRemoved(int count) {
+  CHECK_GE(observers_, count);
+  observers_ -= count;
+  if (observers_ > 0 || destroying_) {
+    return;
+  }
+  // Later, not now: Chromium often drops a watcher and adds the next one in the same call (a tab changing windows,
+  // TabDialogManager re-reading its host), and the widget should not blink off and on between them.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrkDialogHosts::DetachIfUnused, weak_factory_.GetWeakPtr()));
+}
+
+void BrkDialogHosts::DetachIfUnused() {
+  if (observers_ == 0) {
+    Detach();
+  }
+}
+
+// The widget becomes a child of `parent`, so the dialogs on it move, hide and go into full screen with the window.
+// A window that is not on screen in the current Space waits: making it a parent now would switch Spaces under the
+// person (Chromium's own child windows wait the same way, NativeWidgetNSWindowBridge::OrderChildren).
+void BrkDialogHosts::Attach(NSWindow* parent) {
+  if (!parent || !widget_ || destroying_ || observers_ == 0) {
+    return;
+  }
+  if (shown_ && parent_ == parent) {
+    return;
+  }
+  Detach();
+  if (!parent.visible || !parent.onActiveSpace) {
+    WaitFor(parent);
+    return;
+  }
+  shown_ = true;
+  parent_ = parent;
+  PlaceWidget();
+  widget_->ShowInactive();
+  // Views orders a widget with no Views parent against the app's main window. addChildWindow then moves the parent
+  // to where the child is, so the child goes right above its parent first: no Brk window changes place on screen.
+  NSWindow* ns_window = widget_->GetNativeWindow().GetNativeNSWindow();
+  [ns_window orderWindow:NSWindowAbove relativeTo:parent.windowNumber];
+  [parent addChildWindow:ns_window ordered:NSWindowAbove];
+  base::WeakPtr<BrkDialogHosts> weak = weak_factory_.GetWeakPtr();
+  void (^follow)(NSNotification*) = ^(NSNotification*) {
+    if (weak) {
+      weak->PlaceWidget();
+      weak->NotifyPositionsChanged();
+    }
+  };
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  [parent_watchers_ addObject:[center addObserverForName:NSWindowDidResizeNotification object:parent queue:nil usingBlock:follow]];
+  [parent_watchers_ addObject:[center addObserverForName:NSWindowDidMoveNotification object:parent queue:nil usingBlock:follow]];
+  // AppKit leaves a closing window's children on screen as windows of their own.
+  [parent_watchers_ addObject:[center addObserverForName:NSWindowWillCloseNotification
+                                                  object:parent
+                                                   queue:nil
+                                              usingBlock:^(NSNotification*) {
+                                                if (weak) {
+                                                  weak->Detach();
+                                                }
+                                              }]];
+  // Dialogs placed while the widget was detached were placed against its old frame and display.
+  NotifyPositionsChanged();
+}
+
+// Attach once `parent` is on screen in the current Space: the person switched to it, or it came forward.
+void BrkDialogHosts::WaitFor(NSWindow* parent) {
+  base::WeakPtr<BrkDialogHosts> weak = weak_factory_.GetWeakPtr();
+  __weak NSWindow* waiting = parent;
+  void (^retry)(NSNotification*) = ^(NSNotification*) {
+    NSWindow* window = waiting;
+    if (weak && window && !weak->shown_ && weak->observers_ > 0 && window.visible && window.onActiveSpace) {
+      weak->Attach(window);
+    }
+  };
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  [parent_watchers_ addObject:[center addObserverForName:NSWindowDidChangeOcclusionStateNotification
+                                                  object:parent
+                                                   queue:nil
+                                              usingBlock:retry]];
+  [parent_watchers_ addObject:[center addObserverForName:NSWindowDidBecomeKeyNotification
+                                                  object:parent
+                                                   queue:nil
+                                              usingBlock:retry]];
+  NSNotificationCenter* workspace = NSWorkspace.sharedWorkspace.notificationCenter;
+  [workspace_watchers_ addObject:[workspace addObserverForName:NSWorkspaceActiveSpaceDidChangeNotification
+                                                        object:nil
+                                                         queue:nil
+                                                    usingBlock:retry]];
+}
+
+void BrkDialogHosts::StopWatchingParent() {
+  for (id token in parent_watchers_) {
+    [NSNotificationCenter.defaultCenter removeObserver:token];
+  }
+  [parent_watchers_ removeAllObjects];
+  for (id token in workspace_watchers_) {
+    [NSWorkspace.sharedWorkspace.notificationCenter removeObserver:token];
+  }
+  [workspace_watchers_ removeAllObjects];
+}
+
+void BrkDialogHosts::Detach() {
+  StopWatchingParent();
+  if (!shown_) {
+    return;
+  }
+  shown_ = false;
+  parent_ = nil;
+  if (!widget_) {
+    return;
+  }
+  NSWindow* ns_window = widget_->GetNativeWindow().GetNativeNSWindow();
+  [ns_window.parentWindow removeChildWindow:ns_window];
+  widget_->Hide();
+}
+
+// The widget covers its parent, transparent and click-through: Chromium checks that a dialog overlaps its host and
+// keeps it on the host's display.
+void BrkDialogHosts::PlaceWidget() {
+  if (!parent_ || !widget_) {
+    return;
+  }
+  widget_->SetBounds(gfx::ScreenRectFromNSRect(parent_.frame));
+}
