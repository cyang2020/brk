From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brk Engine <brk-engine@localhost>
Date: Sat, 7 Nov 2026 22:21:31 +0800
Subject: [PATCH] brk: the other places that name the framework, and the order
 of its exports

---
 chrome/app/framework.order                                  | 4 ++++
 chrome/browser/web_applications/os_integration/mac/BUILD.gn | 2 +-
 content/public/app/BUILD.gn                                 | 2 +-
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/chrome/app/framework.order b/chrome/app/framework.order
index 6dbc3aeff3f8b61285d4324fcb0eee6dcfe1b6ca..617bac9bdc1bf3f9afe7ed2a5ce635383720b60b 100644
--- a/chrome/app/framework.order
+++ b/chrome/app/framework.order
@@ -29,5 +29,9 @@ _ChromeAppModeStart_v8
 # Entry point for the web app shortcut copier.
 _ChromeWebAppShortcutCopierMain
 
+# Entry points of Brk's shell (brk/browser/brk_application.mm).
+_BrkCoreApplicationPrepare
+_BrkCoreApplicationShared
+
 # _ChromeMain must be listed last.  That's the whole point of this file.
 _ChromeMain
diff --git a/chrome/browser/web_applications/os_integration/mac/BUILD.gn b/chrome/browser/web_applications/os_integration/mac/BUILD.gn
index 16a0aeeaa62275fb9bfc4ef8bf929afff6e0ce48..bdaee1489378e5bcbd3108b6d749d66bf8d23dee 100644
--- a/chrome/browser/web_applications/os_integration/mac/BUILD.gn
+++ b/chrome/browser/web_applications/os_integration/mac/BUILD.gn
@@ -42,7 +42,7 @@ executable("web_app_shortcut_copier") {
       # The helper is a standalone tool rather than a bundled app so the
       # framework's install name does not work as-is. Rewrite it so the
       # relative path is correct given the executable's location.
-      "-Wcrl,installnametool,-change,@executable_path/../Frameworks/${chrome_product_full_name} Framework.framework/Versions/${chrome_version_full}/${chrome_product_full_name} Framework,@executable_path/../${chrome_product_full_name} Framework",
+      "-Wcrl,installnametool,-change,@executable_path/../Frameworks/BrkCore.framework/Versions/${chrome_version_full}/BrkCore,@executable_path/../BrkCore",
     ]
 
     if (is_asan || is_ubsan_any) {
diff --git a/content/public/app/BUILD.gn b/content/public/app/BUILD.gn
index 02d8aacfe00ba9a2e725d43e8b862b83f5b74b7f..ca1e43645923c175c920eea37f75c82501e4c5b8 100644
--- a/content/public/app/BUILD.gn
+++ b/content/public/app/BUILD.gn
@@ -123,7 +123,7 @@ if (is_mac) {
         "-Wl,-rpath,@loader_path/../../../../../../..",
       ]
     } else {
-      ldflags += [ "-Wl,-install_name,@executable_path/../Frameworks/$chrome_product_full_name Framework.framework/Versions/$chrome_version_full/Libraries/libaperitif.dylib" ]
+      ldflags += [ "-Wl,-install_name,@executable_path/../Frameworks/BrkCore.framework/Versions/$chrome_version_full/Libraries/libaperitif.dylib" ]
     }
 
     allow_circular_includes_from = [
