 #include "chrome/browser/profiles/profile.h"
@@ -221,6 +222,7 @@ BrkWebContents* PageForContents(content::WebContents* contents) {
     _contents = contents;
     _browser = browser;
     BrkPage::CreateForWebContents(contents, self);
+    brkcore::WatchMediaPlayers(contents, self);
     _nativeView = contents->GetNativeView().GetNativeNSView();
   }
   return self;
@@ -473,6 +475,14 @@ BrkWebContents* PageForContents(content::WebContents* contents) {
   return security;
 }
 
+- (BOOL)controlMediaPlayerInFrame:(int)frame
+                          element:(NSString*)element
+                        operation:(NSString*)operation
+                           volume:(double)volume {
+  return _contents && brkcore::ControlMediaPlayer(_contents, frame, base::SysNSStringToUTF8(element),
+                                                  base::SysNSStringToUTF8(operation), volume);
+}
+
 - (void)setPermission:(BrkCorePermissionKind)kinds
      requestingOrigin:(NSURL*)requesting
        topLevelOrigin:(NSURL*)topLevel
