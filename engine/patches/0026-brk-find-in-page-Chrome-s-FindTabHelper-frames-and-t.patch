+// A random id for one document of a frame (Chromium keeps its own DocumentToken private to content/): a frame's next document gets a
+// new one, and Brk's isolated world state, which lives on that document's window, goes with it.
+class BrkDocumentID : public content::DocumentUserData<BrkDocumentID> {
+ public:
+  ~BrkDocumentID() override = default;
+  const std::string& value() const { return value_; }
+
+ private:
+  explicit BrkDocumentID(content::RenderFrameHost* frame)
+      : DocumentUserData(frame), value_(base::Token::CreateRandom().ToString()) {}
+  friend content::DocumentUserData<BrkDocumentID>;
+  DOCUMENT_USER_DATA_KEY_DECL();
+
+  const std::string value_;
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(BrkDocumentID);
+
+NSString* FrameID(content::RenderFrameHost* frame) {
+  return base::SysUTF8ToNSString(frame->GetFrameToken().ToString());
+}
+
+NSString* DocumentID(content::RenderFrameHost* frame) {
+  return base::SysUTF8ToNSString(BrkDocumentID::GetOrCreateForCurrentDocument(frame)->value());
+}
+
+// A frame of the page's current document tree that runs and is not on its way out.
+bool IsLiveFrame(content::RenderFrameHost* frame) {
+  return frame->IsRenderFrameLive() &&
+         frame->GetLifecycleState() == content::RenderFrameHost::LifecycleState::kActive;
+}
