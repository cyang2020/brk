+- (NSDictionary<NSString*, NSString*>*)frameDocuments {
+  NSMutableDictionary<NSString*, NSString*>* frames = [NSMutableDictionary dictionary];
+  if (_contents) {
+    _contents->GetPrimaryMainFrame()->ForEachRenderFrameHost([frames](content::RenderFrameHost* frame) {
+      if (IsLiveFrame(frame)) {
+        frames[FrameID(frame)] = DocumentID(frame);
+      }
+    });
+  }
+  return frames;
+}
+
+- (NSString*)focusedFrame {
+  content::RenderFrameHost* frame = _contents ? _contents->GetFocusedFrame() : nullptr;
+  if (!frame || content::WebContents::FromRenderFrameHost(frame) != _contents.get() || !IsLiveFrame(frame) ||
+      &frame->GetPage() != &_contents->GetPrimaryPage()) {
+    return nil;
+  }
+  return FrameID(frame);
+}
+
+- (content::RenderFrameHost*)liveFrame:(NSString*)frame {
+  if (!_contents) {
+    return nullptr;
+  }
+  const std::string wanted = base::SysNSStringToUTF8(frame);
+  content::RenderFrameHost* found = nullptr;
+  _contents->GetPrimaryMainFrame()->ForEachRenderFrameHost([&](content::RenderFrameHost* candidate) {
+    if (!found && IsLiveFrame(candidate) && candidate->GetFrameToken().ToString() == wanted) {
+      found = candidate;
+    }
+  });
+  return found;
+}
+
+- (void)evaluateIsolatedScript:(NSString*)script
+                       inFrame:(NSString*)frame
+                      document:(NSString*)document
+                    completion:(void (^)(NSString* _Nullable))completion {
+  content::RenderFrameHost* target = [self liveFrame:frame];
+  if (!target || ![DocumentID(target) isEqualToString:document]) {
+    completion(nil);
+    return;
+  }
+  // Chrome's world for its own page scripts (DOM distiller and the like): the page's scripts cannot reach it, and Brk's globals there
+  // have their own names. If the frame goes first, Chromium drops the callback; the caller has its own time limit.
+  target->ExecuteJavaScriptInIsolatedWorld(base::SysNSStringToUTF16(script), base::BindOnce(^(base::Value value) {
+                                             if (value.is_none()) {
+                                               completion(nil);
+                                               return;
+                                             }
+                                             std::string json;
+                                             base::JSONWriter::Write(value, &json);
+                                             completion(base::SysUTF8ToNSString(json));
+                                           }),
+                                           ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+- (void)exitFullscreen {
+  if (_contents) {
+    _contents->ExitFullscreen(/*will_cause_resize=*/true);
+  }
+}
