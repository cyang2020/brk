+- (void)setCookies:(NSArray<NSDictionary<NSString*, id>*>*)cookies completion:(void (^)(NSUInteger))completion {
+  if (!_profile || cookies.count == 0) {
+    completion(0);
+    return;
+  }
+  network::mojom::CookieManager* manager =
+      _profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+  __block NSUInteger accepted = 0;
+  // Written to disk before the answer, as CEF's import flushes: the app may restart right after an import.
+  base::RepeatingClosure done = base::BarrierClosure(cookies.count, base::BindOnce(^{
+                                                       manager->FlushCookieStore(base::BindOnce(^{
+                                                         completion(accepted);
+                                                       }));
+                                                     }));
+  auto string = [](NSDictionary* cookie, NSString* key) {
+    id value = cookie[key];
+    return std::string([value isKindOfClass:[NSString class]] ? [value UTF8String] : "");
+  };
+  auto time = [](NSDictionary* cookie, NSString* key) {
+    id value = cookie[key];
+    return [value isKindOfClass:[NSNumber class]] ? base::Time::FromSecondsSinceUnixEpoch([value doubleValue]) : base::Time();
+  };
+  for (NSDictionary* cookie in cookies) {
+    const GURL url(string(cookie, @"url"));
+    const bool http_only = [cookie[@"httpOnly"] boolValue];
+    net::CookieSameSite same_site = net::CookieSameSite::UNSPECIFIED;
+    switch ([cookie[@"sameSite"] intValue]) {
+      case 0: same_site = net::CookieSameSite::NO_RESTRICTION; break;
+      case 1: same_site = net::CookieSameSite::LAX_MODE; break;
+      case 2: same_site = net::CookieSameSite::STRICT_MODE; break;
+      default: break;
+    }
+    net::CookiePriority priority = net::COOKIE_PRIORITY_MEDIUM;
+    switch ([cookie[@"priority"] intValue]) {
+      case 0: priority = net::COOKIE_PRIORITY_LOW; break;
+      case 2: priority = net::COOKIE_PRIORITY_HIGH; break;
+      default: break;
+    }
+    net::CookieInclusionStatus status;
+    std::unique_ptr<net::CanonicalCookie> canonical = net::CanonicalCookie::CreateSanitizedCookie(
+        url, string(cookie, @"name"), string(cookie, @"value"), string(cookie, @"domain"), string(cookie, @"path"),
+        time(cookie, @"creation"), time(cookie, @"expires"), time(cookie, @"lastAccess"), [cookie[@"secure"] boolValue],
+        http_only, same_site, priority, /*partition_key=*/std::nullopt, &status);
+    if (!canonical) {
+      done.Run();
+      continue;
+    }
+    // As CEF's cookie manager and Chrome's importer: the import writes what the browser itself would accept from that site.
+    net::CookieOptions options;
+    if (http_only) {
+      options.set_include_httponly();
+    }
+    options.set_same_site_cookie_context(net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+    manager->SetCanonicalCookie(*canonical, url, options, base::BindOnce(^(net::CookieAccessResult result) {
+                                  if (result.status.IsInclude()) {
+                                    accepted += 1;
+                                  }
+                                  done.Run();
+                                }));
+  }
+}
