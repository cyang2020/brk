       "//chrome/app/vector_icons",
       "//chrome/browser:resources",
diff --git a/chrome/browser/ui/webauthn/ambient/ambient_signin_controller.cc b/chrome/browser/ui/webauthn/ambient/ambient_signin_controller.cc
index 5d10952685ab6d7e051304dee3d8fe683b9ace2d..fc3b0aafd62d91ca8d943fed1a72af4c5465cfba 100644
--- a/chrome/browser/ui/webauthn/ambient/ambient_signin_controller.cc
