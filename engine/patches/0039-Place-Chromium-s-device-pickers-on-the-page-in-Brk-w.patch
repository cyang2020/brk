 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
 #include "chrome/browser/ui/page_action/action_ids.h"
@@ -116,8 +117,13 @@ void AmbientSigninController::ShowBubbleView() {
   }
   BrowserWindowInterface* browser =
       GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(web_contents);
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  // A Brk window has no toolbar to anchor the bubble to.
+  if (brkcore::IsEmbedded() && !browser_view) {
+    return;
+  }
   ToolbarButtonProvider* button_provider =
-      BrowserView::GetBrowserViewForBrowser(browser)->toolbar_button_provider();
+      browser_view->toolbar_button_provider();
   auto anchor = button_provider->GetBubbleAnchor(std::nullopt);
 
   if (!ambient_signin_bubble_view_) {
