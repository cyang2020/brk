diff --git a/brk/browser/brk_save_prompts.h b/brk/browser/brk_save_prompts.h
new file mode 100644
index 0000000000000000000000000000000000000000..90a8b00d68b0babbbf68b3e91a703db6c09cab0d
--- /dev/null
+++ b/brk/browser/brk_save_prompts.h
@@ -0,0 +1,16 @@
+#ifndef BRK_BROWSER_BRK_SAVE_PROMPTS_H_
+#define BRK_BROWSER_BRK_SAVE_PROMPTS_H_
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace brkcore {
+
+// Chrome's "Save password?" for one of Brk's pages, asked by the shell with its own card (BrkCoreSaveOffer). False when the page is
+// not Brk's or its delegate does not ask, and Chrome's own code goes on.
+bool OfferPasswordSaveHook(content::WebContents* contents);
+
+}  // namespace brkcore
+
+#endif  // BRK_BROWSER_BRK_SAVE_PROMPTS_H_
diff --git a/brk/browser/brk_save_prompts.mm b/brk/browser/brk_save_prompts.mm
new file mode 100644
index 0000000000000000000000000000000000000000..764435656086ed8791329e95d3a9bfcf987071ae
--- /dev/null
+++ b/brk/browser/brk_save_prompts.mm
@@ -0,0 +1,85 @@
+#import "brk/browser/brk_save_prompts.h"
+
+#import <Foundation/Foundation.h>
+
+#include "base/memory/weak_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#import "brk/browser/brk_web_contents.h"
+#include "brk/public/BrkCore.h"
+#include "chrome/browser/ui/passwords/manage_passwords_ui_controller.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "components/password_manager/core/common/password_manager_ui.h"
+#include "content/public/browser/web_contents.h"
+
+// One offer to save what a page sent. The answer goes to the page's ManagePasswordsUIController as its bubble's buttons would:
+// Save, Never for this site, or neither (the bubble just closes).
+@interface BrkSaveOffer : NSObject <BrkCoreSaveOffer>
+- (instancetype)initWithKind:(BrkCoreSaveKind)kind contents:(content::WebContents*)contents;
+@end
+
+@implementation BrkSaveOffer {
+  BrkCoreSaveKind _kind;
+  NSString* _site;
+  base::WeakPtr<content::WebContents> _contents;
+  BOOL _answered;
+}
+
+- (instancetype)initWithKind:(BrkCoreSaveKind)kind contents:(content::WebContents*)contents {
+  if ((self = [super init])) {
+    _kind = kind;
+    _contents = contents->GetWeakPtr();
+    const std::string host(contents->GetLastCommittedURL().host());
+    _site = host.empty() ? nil : base::SysUTF8ToNSString(host);
+  }
+  return self;
+}
+
+- (BrkCoreSaveKind)kind {
+  return _kind;
+}
+
+- (NSString*)site {
+  return _site;
+}
+
+- (void)answer:(BrkCoreSaveAnswer)answer {
+  if (_answered || !_contents) {
+    return;
+  }
+  _answered = YES;
+  ManagePasswordsUIController* controller = ManagePasswordsUIController::FromWebContents(_contents.get());
+  // The page navigated or the offer was replaced: the pending login is gone, nothing to answer.
+  if (!controller || controller->GetState() != password_manager::ui::PENDING_PASSWORD_STATE) {
+    return;
+  }
+  switch (answer) {
+    case BrkCoreSaveAnswerSave: {
+      const password_manager::PasswordForm& form = controller->GetPendingPassword();
+      controller->SavePassword(form.username_value, form.password_value);
+      break;
+    }
+    case BrkCoreSaveAnswerNever:
+      controller->NeverSavePassword();
+      break;
+    case BrkCoreSaveAnswerNotNow:
+      break;
+  }
+  controller->OnBubbleHidden();
+}
+
+@end
+
+namespace brkcore {
+
+bool OfferPasswordSaveHook(content::WebContents* contents) {
+  BrkWebContents* page = PageForContents(contents);
+  id<BrkCoreWebContentsDelegate> delegate = page.delegate;
+  if (!page || ![delegate respondsToSelector:@selector(webContents:offersToSave:)]) {
+    return false;
+  }
+  BrkSaveOffer* offer = [[BrkSaveOffer alloc] initWithKind:BrkCoreSaveKindPassword contents:contents];
+  [delegate webContents:page offersToSave:offer];
+  return true;
+}
+
+}  // namespace brkcore
diff --git a/brk/embedding/embedding.h b/brk/embedding/embedding.h
index b7e51fd87ad07aa53090a87a2a6f25a87c8e6d71..a347145a69d87440cd2b511e980124dd853028c0 100644
--- a/brk/embedding/embedding.h
+++ b/brk/embedding/embedding.h
@@ -52,6 +52,9 @@ struct Hooks {
   content::JavaScriptDialogManager* (*javascript_dialog_manager)(content::WebContents* source) = nullptr;
   // True when Brk showed the page's context menu itself (one of its pages, which has no Views widget for Chrome's menu).
   bool (*show_context_menu)(RenderViewContextMenuBase* menu) = nullptr;
+  // True when Brk asks itself whether to save the login this page sent (one of its pages: Chrome's bubble needs Views). Brk answers
+  // through the page's ManagePasswordsUIController.
+  bool (*offer_password_save)(content::WebContents* contents) = nullptr;
 };
 
 // True when BrkCore.framework was started by Brk's shell: the shell owns NSApp's delegate, the menu and the quit.
