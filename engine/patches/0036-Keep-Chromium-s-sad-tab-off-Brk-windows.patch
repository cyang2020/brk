From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Casper Yang <casperyang2020@gmail.com>
Date: Sun, 15 Nov 2026 12:36:01 +0800
Subject: [PATCH] Keep Chromium's sad tab off Brk windows

A renderer crash makes SadTabHelper install Chrome's Views sad tab. Its
lookup of the tab's ContentsWebView stopped only when the Browser had no
native window, then dereferenced BrowserView, which Brk windows do not
have: once a window's Browser knew its NSWindow (from its second page
on, and from the start now that Brk tells it at once), any renderer
crash quit Brk. Brk draws its own crashed-page card.
---
 chrome/browser/ui/BUILD.gn              | 1 +
 chrome/browser/ui/sad_tab_controller.cc | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/chrome/browser/ui/BUILD.gn b/chrome/browser/ui/BUILD.gn
index 6e23afdff399078f30e6f5ef69852d1185ddc041..928e739d67761bb2e6555bfdd3c538479be75020 100644
--- a/chrome/browser/ui/BUILD.gn
+++ b/chrome/browser/ui/BUILD.gn
@@ -5496,6 +5496,7 @@ if (toolkit_views) {
 
     deps = [
       ":sad_tab",
+      "//brk:embedding",
       "//chrome/app:generated_resources",
       "//chrome/app/vector_icons",
       "//chrome/browser/feedback",
diff --git a/chrome/browser/ui/sad_tab_controller.cc b/chrome/browser/ui/sad_tab_controller.cc
index 804a89c5584ccacd04d0eece5d21b546cfd4e662..430155ef751ed5a6850892efce4a0fb09935d53a 100644
--- a/chrome/browser/ui/sad_tab_controller.cc
+++ b/chrome/browser/ui/sad_tab_controller.cc
@@ -4,6 +4,7 @@
 
 #include "chrome/browser/ui/sad_tab_controller.h"
 
+#include "brk/embedding/embedding.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/views/frame/browser_view.h"
 #include "chrome/browser/ui/views/frame/contents_web_view.h"
@@ -29,6 +30,9 @@ ContentsWebView* FindContentsWebView(content::WebContents* web_contents) {
     return nullptr;
   }
   BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (brkcore::IsEmbedded() && !browser_view) {
+    return nullptr;
+  }
   DCHECK(browser_view);
 
   for (auto* contents_view : browser_view->GetAllVisibleContentsWebViews()) {
