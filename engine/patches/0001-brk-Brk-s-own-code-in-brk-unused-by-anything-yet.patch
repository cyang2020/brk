+content::KeyboardEventProcessingResult BrkBrowserWindow::PreHandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  BrkBrowser* owner = owner_;
+  BrkWebContents* page = owner.focusedPage;
+  if (!page) {
+    return content::KeyboardEventProcessingResult::NOT_HANDLED;
+  }
+  const BrkCoreKeyAnswer answer = [page keyBeforePage:event];
+  if (answer.handled) {
+    return content::KeyboardEventProcessingResult::HANDLED;
+  }
+  return answer.shortcut ? content::KeyboardEventProcessingResult::NOT_HANDLED_IS_SHORTCUT
+                         : content::KeyboardEventProcessingResult::NOT_HANDLED;
+}
+
+bool BrkBrowserWindow::HandleKeyboardEvent(const input::NativeWebKeyboardEvent& event) {
+  BrkBrowser* owner = owner_;
+  BrkWebContents* page = owner.focusedPage;
+  if (page && [page keyAfterPage:event]) {
+    return true;
+  }
+  // The page left it and so did the shell's table. As in Chrome: the menu bar gets it, so Edit > Copy and friends still have their keys.
+  NSEvent* native = event.os_event.Get();
+  if (native && event.GetType() != blink::WebInputEvent::Type::kKeyUp &&
+      (native.modifierFlags & NSEventModifierFlagCommand)) {
+    return [NSApp.mainMenu performKeyEquivalent:native];
+  }
+  return false;
+}
