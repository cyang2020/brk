+- (instancetype)initWithContents:(content::WebContents*)contents browser:(BrkBrowser*)browser {
+  if ((self = [super init])) {
+    _contents = contents;
+    _browser = browser;
+    BrkPage::CreateForWebContents(contents, self);
+    _nativeView = contents->GetNativeView().GetNativeNSView();
