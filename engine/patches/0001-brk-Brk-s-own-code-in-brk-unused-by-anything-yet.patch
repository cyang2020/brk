+NSURL* NSURLFromGURL(const GURL& url) {
+  return url.is_valid() ? net::NSURLWithGURL(url) : nil;
+}
+
+NSEventModifierFlags FlagsFromModifiers(int modifiers) {
+  NSEventModifierFlags flags = 0;
+  if (modifiers & blink::WebInputEvent::kMetaKey) {
+    flags |= NSEventModifierFlagCommand;
+  }
+  if (modifiers & blink::WebInputEvent::kShiftKey) {
+    flags |= NSEventModifierFlagShift;
+  }
+  if (modifiers & blink::WebInputEvent::kAltKey) {
+    flags |= NSEventModifierFlagOption;
+  }
+  if (modifiers & blink::WebInputEvent::kControlKey) {
+    flags |= NSEventModifierFlagControl;
+  }
+  return flags;
+}
+
+// Holds the page's Chromium side: the observer that turns Chromium's callbacks into delegate calls, and its DevTools session.
+class BrkPage : public content::WebContentsObserver,
+                public content::WebContentsUserData<BrkPage> {
+ public:
+  ~BrkPage() override = default;
+
+  BrkWebContents* owner() const { return owner_; }
+  brkcore::BrkDevToolsSession& devtools() {
+    if (!devtools_) {
+      devtools_ = std::make_unique<brkcore::BrkDevToolsSession>(&GetWebContents());
+    }
+    return *devtools_;
+  }
+  bool closing_by_shell() const { return closing_by_shell_; }
+  void set_closing_by_shell() { closing_by_shell_ = true; }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (!handle->IsInPrimaryMainFrame()) {
+      return;
+    }
+    id<BrkCoreWebContentsDelegate> delegate = owner_.delegate;
+    NSURL* url = NSURLFromGURL(handle->GetURL());
+    if (handle->HasCommitted() && !handle->IsErrorPage()) {
+      if (handle->IsSameDocument()) {
+        [delegate webContents:owner_ didChangeAddress:url];
+      } else {
+        [delegate webContents:owner_ didStartDocument:url];
+      }
+    } else if (handle->GetNetErrorCode() != net::OK) {
+      [delegate webContents:owner_
+            didFailLoadCode:handle->GetNetErrorCode()
+                description:base::SysUTF8ToNSString(net::ErrorToShortString(handle->GetNetErrorCode()))
+                        url:base::SysUTF8ToNSString(handle->GetURL().spec())];
+    }
+    ReportLoading();
+  }
+  void DidStartLoading() override { ReportLoading(); }
+  void DidStopLoading() override { ReportLoading(); }
+  void DidFinishLoad(content::RenderFrameHost* frame, const GURL& url) override {
+    if (frame->IsInPrimaryMainFrame()) {
+      [owner_.delegate webContents:owner_ didFinishDocument:NSURLFromGURL(url)];
+    }
+  }
+  void DidFailLoad(content::RenderFrameHost* frame, const GURL& url, int error_code) override {
+    if (frame->IsInPrimaryMainFrame()) {
+      [owner_.delegate webContents:owner_
+                   didFailLoadCode:error_code
+                       description:base::SysUTF8ToNSString(net::ErrorToShortString(error_code))
+                               url:base::SysUTF8ToNSString(url.spec())];
+    }
+  }
+  void LoadProgressChanged(double progress) override {
+    [owner_.delegate webContents:owner_ didChangeProgress:progress];
+  }
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    [owner_.delegate webContents:owner_
+                  didChangeTitle:base::SysUTF16ToNSString(GetWebContents().GetTitle())];
+  }
+  void DidUpdateFaviconURL(content::RenderFrameHost* frame,
+                           const std::vector<blink::mojom::FaviconURLPtr>& candidates,
+                           blink::mojom::FaviconUpdateReason reason) override {
+    if (!frame->IsInPrimaryMainFrame()) {
+      return;
+    }
+    [owner_.delegate webContents:owner_
+                didChangeFavicon:candidates.empty() ? nil : NSURLFromGURL(candidates[0]->icon_url)];
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus status) override {
+    [owner_.delegate webContentsRendererGone:owner_];
+  }
+  void OnWebContentsFocused(content::RenderWidgetHost* host) override {
+    [owner_.delegate webContentsDidGainFocus:owner_];
+  }
+  void WebContentsDestroyed() override;
+
+ private:
+  friend class content::WebContentsUserData<BrkPage>;
+  BrkPage(content::WebContents* contents, BrkWebContents* owner)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<BrkPage>(*contents),
+        owner_(owner) {}
+
+  void ReportLoading() {
+    content::WebContents& contents = GetWebContents();
+    [owner_.delegate webContents:owner_
+                didChangeLoading:contents.IsLoading()
+                       canGoBack:contents.GetController().CanGoBack()
+                    canGoForward:contents.GetController().CanGoForward()];
+  }
+
+  __weak BrkWebContents* owner_;
+  std::unique_ptr<brkcore::BrkDevToolsSession> devtools_;
+  bool closing_by_shell_ = false;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BrkPage);
+
+}  // namespace
