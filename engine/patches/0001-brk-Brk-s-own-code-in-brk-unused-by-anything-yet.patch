+
+- (void)evaluateJavaScript:(NSString*)script
+                completion:(void (^)(NSString* _Nullable, NSString* _Nullable))completion {
+  if (!_contents) {
+    if (completion) {
+      completion(nil, @"The page closed");
+    }
+    return;
+  }
+  content::RenderFrameHost::AllowInjectingJavaScript();
+  _contents->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+      base::SysNSStringToUTF16(script),
+      base::BindOnce(
+          [](void (^completion)(NSString*, NSString*), base::Value value) {
+            if (completion) {
+              std::string json;
+              base::JSONWriter::Write(value, &json);
+              completion(base::SysUTF8ToNSString(json), nil);
+            }
+          },
+          completion),
+      content::ISOLATED_WORLD_ID_GLOBAL);
+}
+
+- (void)sendDevToolsCommand:(NSString*)method
+                 parameters:(NSString*)parameters
+                 completion:(void (^)(NSString* _Nullable, NSString* _Nullable))completion {
+  BrkPage* page = _contents ? BrkPage::FromWebContents(_contents) : nullptr;
+  if (!page) {
+    completion(nil, @"The page closed");
+    return;
+  }
+  page->devtools().Send(
+      base::SysNSStringToUTF8(method), base::SysNSStringToUTF8(parameters),
+      base::BindOnce(
+          [](void (^completion)(NSString*, NSString*), const std::string& result,
+             const std::string& error) {
+            completion(error.empty() ? base::SysUTF8ToNSString(result) : nil,
+                       error.empty() ? nil : base::SysUTF8ToNSString(error));
+          },
+          completion));
+}
