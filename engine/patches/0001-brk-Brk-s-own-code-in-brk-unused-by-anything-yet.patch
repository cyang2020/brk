diff --git a/brk/browser/brk_devtools_session.cc b/brk/browser/brk_devtools_session.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f9893c1a5854565cfec569c9c794239fb01edd5e
--- /dev/null
+++ b/brk/browser/brk_devtools_session.cc
@@ -0,0 +1,102 @@
+#include "brk/browser/brk_devtools_session.h"
+
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents.h"
+
+namespace brkcore {
+
+BrkDevToolsSession::BrkDevToolsSession(content::WebContents* contents) : contents_(contents) {}
+
+BrkDevToolsSession::~BrkDevToolsSession() {
+  if (host_) {
+    host_->DetachClient(this);
+  }
+  FailAll("The page closed");
+}
+
+void BrkDevToolsSession::Send(const std::string& method,
+                              const std::string& parameters_json,
+                              Reply reply) {
+  std::optional<base::Value> parameters = base::JSONReader::Read(
+      parameters_json.empty() ? "{}" : parameters_json, base::JSON_PARSE_RFC);
+  if (!parameters || !parameters->is_dict()) {
+    std::move(reply).Run(std::string(), "Parameters are not a JSON object");
+    return;
+  }
+  if (!host_) {
+    host_ = content::DevToolsAgentHost::GetOrCreateFor(contents_);
+    if (!host_->AttachClient(this)) {
+      host_ = nullptr;
+      std::move(reply).Run(std::string(), "DevTools could not attach");
+      return;
+    }
+  }
+  const int id = next_id_++;
+  waiting_[id] = std::move(reply);
+  base::DictValue command;
+  command.Set("id", id);
+  command.Set("method", method);
+  command.Set("params", std::move(*parameters));
+  std::string text;
+  base::JSONWriter::Write(command, &text);
+  host_->DispatchProtocolMessage(this, base::as_byte_span(text));
+}
+
+void BrkDevToolsSession::DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                                                 base::span<const uint8_t> message) {
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      std::string_view(reinterpret_cast<const char*>(message.data()), message.size()),
+      base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  const base::DictValue& dict = parsed->GetDict();
+  std::optional<int> id = dict.FindInt("id");
+  if (!id) {
+    return;  // An event; none was enabled on purpose.
+  }
+  auto waiter = waiting_.find(*id);
+  if (waiter == waiting_.end()) {
+    return;
+  }
+  Reply reply = std::move(waiter->second);
+  waiting_.erase(waiter);
+  if (const base::DictValue* error = dict.FindDict("error")) {
+    const std::string* text = error->FindString("message");
+    std::move(reply).Run(std::string(), text ? *text : std::string("DevTools error"));
+  } else {
+    std::string result = "{}";
+    if (const base::DictValue* value = dict.FindDict("result")) {
+      base::JSONWriter::Write(*value, &result);
+    }
+    std::move(reply).Run(result, std::string());
+  }
+  if (waiting_.empty() && host_) {
+    host_->DetachClient(this);
+    host_ = nullptr;
+  }
+}
+
+void BrkDevToolsSession::AgentHostClosed(content::DevToolsAgentHost* agent_host) {
+  host_ = nullptr;
+  FailAll("DevTools closed");
+}
+
+bool BrkDevToolsSession::IsTrusted() {
+  return true;
+}
+
+void BrkDevToolsSession::FailAll(const std::string& error) {
+  std::map<int, Reply> waiting = std::move(waiting_);
+  waiting_.clear();
+  for (auto& entry : waiting) {
+    std::move(entry.second).Run(std::string(), error);
+  }
+}
+
+}  // namespace brkcore
