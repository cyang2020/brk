@@ -0,0 +1,43 @@
+#include "brk/browser/brk_navigation_throttle.h"
+
+#include <memory>
+
+#import "brk/browser/brk_web_contents.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+
+namespace brkcore {
+
+namespace {
+
+class BrkNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit BrkNavigationThrottle(content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  ThrottleCheckResult WillStartRequest() override { return Decide(/*redirect=*/false); }
+  ThrottleCheckResult WillRedirectRequest() override { return Decide(/*redirect=*/true); }
+  const char* GetNameForLogging() override { return "BrkNavigationThrottle"; }
+
+ private:
+  ThrottleCheckResult Decide(bool redirect) {
+    BrkWebContents* page = PageForContents(navigation_handle()->GetWebContents());
+    if (!page || !navigation_handle()->IsInPrimaryMainFrame()) {
+      return PROCEED;
+    }
+    return [page decideNavigationTo:navigation_handle()->GetURL()
+                         isRedirect:redirect
+                        userGesture:navigation_handle()->HasUserGesture()]
+               ? PROCEED
+               : CANCEL_AND_IGNORE;
+  }
+};
+
+}  // namespace
+
+void AddNavigationThrottles(content::NavigationThrottleRegistry& registry) {
+  registry.AddThrottle(std::make_unique<BrkNavigationThrottle>(registry));
+}
+
+}  // namespace brkcore
