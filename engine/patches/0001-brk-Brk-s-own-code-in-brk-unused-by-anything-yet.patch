+// Chrome calls this when the tab strip empties and when it closes all windows. It may be deep inside a tab strip notification, so the
+// Browser goes on the next task.
+void BrkBrowserWindow::Close() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrkBrowserWindow::DestroyBrowser, weak_factory_.GetWeakPtr()));
+}
+
+void BrkBrowserWindow::DestroyBrowser() {
+  // As Chrome's own window when its native widget goes: no warning about downloads, the shell has already decided.
+  UnloadController::From(browser_)->set_force_skip_warning_user_on_close(true);
+  UnloadController::From(browser_)->OnWindowClosing();
+  if (!browser_->GetTabStripModel()->empty()) {
+    browser_->GetTabStripModel()->CloseAllTabs();
+    closing_ = false;
+    return;  // Chrome calls Close() again when the strip is empty.
+  }
+  BrkBrowser* owner = owner_;
+  [owner browserWillGo];
+  BrowserManagerService::SynchronouslyDestroyBrowser(browser_);
+}
