+namespace brkcore {
+BrkWebContents* PageForContents(content::WebContents* contents) {
+  BrkPage* page = BrkPage::FromWebContents(contents);
+  return page ? page->owner() : nil;
+}
+}  // namespace brkcore
+
+@interface BrkWebContents ()
+- (void)contentsWillGo:(BOOL)byShell;
+@end
