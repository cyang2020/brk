+#ifndef BRK_BROWSER_BRK_DEVTOOLS_SESSION_H_
+#define BRK_BROWSER_BRK_DEVTOOLS_SESSION_H_
+
+#include <map>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace brkcore {
+
+// One page's DevTools protocol commands, for what the shell asks (page text, PDF, MHTML). Attaches for a command and detaches when
+// none is waiting, so a page has no DevTools session attached while idle.
+class BrkDevToolsSession : public content::DevToolsAgentHostClient {
+ public:
+  // (result JSON, error). Exactly one is non-empty.
+  using Reply = base::OnceCallback<void(const std::string& result, const std::string& error)>;
+
+  explicit BrkDevToolsSession(content::WebContents* contents);
+  ~BrkDevToolsSession() override;
+
+  void Send(const std::string& method, const std::string& parameters_json, Reply reply);
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+  bool IsTrusted() override;
+
+ private:
+  void FailAll(const std::string& error);
+
+  const raw_ptr<content::WebContents> contents_;
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  std::map<int, Reply> waiting_;
+  int next_id_ = 1;
+};
+
+}  // namespace brkcore
+
+#endif  // BRK_BROWSER_BRK_DEVTOOLS_SESSION_H_
