@@ -0,0 +1,40 @@
+#ifndef BRK_BROWSER_BRK_BROWSER_H_
+#define BRK_BROWSER_BRK_BROWSER_H_
+
+#import <Foundation/Foundation.h>
+
+#include "brk/public/BrkCore.h"
+
+class BrowserWindow;
+class BrowserWindowInterface;
+class GURL;
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+@class BrkWebContents;
+
+NS_ASSUME_NONNULL_BEGIN
+
+// Chrome's Browser for one Brk window and profile, with its pages as tabs.
+@interface BrkBrowser : NSObject <BrkCoreBrowser>
+- (instancetype)initWithProfile:(Profile*)profile
+                         window:(nullable NSWindow*)window
+                       delegate:(nullable id<BrkCoreBrowserDelegate>)delegate;
+@property(nonatomic, readonly, nullable) BrkWebContents* focusedPage;
+- (void)closeContents:(content::WebContents*)contents;
+- (void)pageDidGo:(BrkWebContents*)page;
+- (void)browserWillGo;
+@end
+
+namespace brkcore {
+// Installed in brkcore::Hooks. The window of the BrkBrowser being created; null for every other Browser.
+BrowserWindow* _Nullable CreateBrowserWindowHook(BrowserWindowInterface* browser);
+bool UpdateTargetURLHook(content::WebContents* source, const GURL& url);
+}  // namespace brkcore
+
+NS_ASSUME_NONNULL_END
+
+#endif  // BRK_BROWSER_BRK_BROWSER_H_
diff --git a/brk/browser/brk_browser.mm b/brk/browser/brk_browser.mm
new file mode 100644
index 0000000000000000000000000000000000000000..4124edbbf14c9ec87ce6805491de83374870f845
--- /dev/null
+++ b/brk/browser/brk_browser.mm
@@ -0,0 +1,349 @@
+#import "brk/browser/brk_browser.h"
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/memory/raw_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#import "brk/browser/brk_browser_window.h"
+#import "brk/browser/brk_extension_action.h"
+#import "brk/browser/brk_web_contents.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/extensions/extension_action_delegate.h"
+#include "chrome/browser/ui/extensions/extension_action_view_model.h"
+#include "chrome/browser/ui/extensions/extension_popup_types.h"
+#include "chrome/browser/ui/extensions/extensions_container.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/toolbar/toolbar_action_view_model.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/extension.h"
+#include "net/base/apple/url_conversions.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Set while a BrkBrowser creates its Browser, so the window factory knows whose it is.
+BrkBrowser* g_creating = nil;
+brkcore::BrkBrowserWindow* g_created_window = nullptr;
+
+GURL TargetURL(content::WebContents* contents) {
+  content::NavigationEntry* entry = contents->GetController().GetPendingEntry();
+  if (!entry) {
+    entry = contents->GetController().GetVisibleEntry();
+  }
+  return entry ? entry->GetURL() : GURL();
+}
+
+}  // namespace
+
+@interface BrkBrowser ()
+- (void)tabInserted:(content::WebContents*)contents active:(BOOL)active;
+- (nullable ExtensionActionViewModel*)modelForExtension:(const std::string&)extensionID;
+@end
+
+namespace brkcore {
+
+class BrkTabStripObserver : public TabStripModelObserver {
+ public:
+  explicit BrkTabStripObserver(BrkBrowser* owner) : owner_(owner) {}
+
+  void OnTabStripModelChanged(TabStripModel* model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override {
+    if (change.type() != TabStripModelChange::kInserted) {
+      return;
+    }
+    for (const auto& inserted : change.GetInsert()->contents) {
+      [owner_ tabInserted:inserted.contents active:selection.new_contents == inserted.contents];
+    }
+  }
+
+ private:
+  __weak BrkBrowser* const owner_;
+};
+
+// What chrome.action.openPopup() and the DevTools protocol's Extensions.triggerAction look for in a Browser.
+class BrkExtensionsContainer final : public ExtensionsContainer {
+ public:
+  explicit BrkExtensionsContainer(BrkBrowser* owner) : owner_(owner) {}
+
+  ToolbarActionViewModel* GetActionForId(const std::string& action_id) override {
+    return [owner_ modelForExtension:action_id];
+  }
+  void HideActivePopup() override { [owner_ closeExtensionPopup]; }
+  void CloseExtensionsMenuIfOpen() override {}
+  bool ShowToolbarActionPopupForAPICall(const std::string& action_id, ShowPopupCallback callback) override {
+    ExtensionActionViewModel* model = [owner_ modelForExtension:action_id];
+    if (!model) {
+      return false;
+    }
+    [owner_ closeExtensionPopup];
+    model->TriggerPopupForAPI(std::move(callback));
+    return true;
+  }
+  void ToggleExtensionsMenu() override {}
+  bool HasAnyExtensions() const override { return true; }
+
+ private:
+  __weak BrkBrowser* const owner_;
+};
+
+BrowserWindow* CreateBrowserWindowHook(BrowserWindowInterface* browser) {
+  if (!g_creating) {
+    return nullptr;
+  }
+  g_created_window = new BrkBrowserWindow(browser, g_creating);
+  return g_created_window;
+}
+
+bool UpdateTargetURLHook(content::WebContents* source, const GURL& url) {
+  BrkWebContents* page = PageForContents(source);
+  if (!page) {
+    return false;
+  }
+  [page hoverLink:url];
+  return true;
+}
+
+}  // namespace brkcore
+
+@implementation BrkBrowser {
+  raw_ptr<BrowserWindowInterface> _browser;
+  raw_ptr<brkcore::BrkBrowserWindow> _window;
+  std::unique_ptr<brkcore::BrkTabStripObserver> _observer;
+  std::unique_ptr<brkcore::BrkExtensionsContainer> _extensionsContainer;
+  std::unique_ptr<ui::ScopedUnownedUserData<ExtensionsContainer>> _extensionsContainerData;
+  NSMutableArray<BrkWebContents*>* _pages;
+  // Pages Chromium made by itself (a link with target=_blank) that the shell was told about and has not taken yet.
+  NSMutableArray<BrkWebContents*>* _unadopted;
+  __weak id<BrkCoreBrowserDelegate> _delegate;
+  __weak NSWindow* _nativeWindow;
+  std::map<std::string, std::unique_ptr<ExtensionActionViewModel>> _actionModels;
+  BOOL _creatingPage;
+  NSString* _openPopupExtension;
+}
+
+@synthesize delegate = _delegate;
+
+- (instancetype)initWithProfile:(Profile*)profile
+                         window:(NSWindow*)window
+                       delegate:(id<BrkCoreBrowserDelegate>)delegate {
+  if ((self = [super init])) {
+    _pages = [NSMutableArray array];
+    _unadopted = [NSMutableArray array];
+    _delegate = delegate;
+    _nativeWindow = window;
+    g_creating = self;
+    BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL, *profile, /*from_user_gesture=*/true);
+    _browser = CreateBrowserWindow(std::move(params));
+    g_creating = nil;
+    _window = g_created_window;
+    g_created_window = nullptr;
+    _window->SetNativeWindow(window);
+    _observer = std::make_unique<brkcore::BrkTabStripObserver>(self);
+    _browser->GetTabStripModel()->AddObserver(_observer.get());
+    _extensionsContainer = std::make_unique<brkcore::BrkExtensionsContainer>(self);
+    _extensionsContainerData = std::make_unique<ui::ScopedUnownedUserData<ExtensionsContainer>>(
+        _browser->GetUnownedUserDataHost(), *_extensionsContainer);
+  }
+  return self;
+}
+
+- (BOOL)isAlive {
+  return _browser != nullptr;
+}
+
+- (NSWindow*)window {
+  return _nativeWindow;
+}
+
+- (void)setWindow:(NSWindow*)window {
+  _nativeWindow = window;
+  if (_window) {
+    _window->SetNativeWindow(window);
+  }
+}
+
+- (BrkWebContents*)focusedPage {
+  for (BrkWebContents* page in _pages) {
+    content::RenderWidgetHostView* view =
+        page.contents ? page.contents->GetRenderWidgetHostView() : nullptr;
+    if (view && view->HasFocus()) {
+      return page;
+    }
+  }
+  content::WebContents* active = _browser ? _browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  return active ? brkcore::PageForContents(active) : nil;
+}
+
+- (id<BrkCoreWebContents>)createWebContents {
+  content::WebContents::CreateParams params(_browser->GetProfile());
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> owned = content::WebContents::Create(params);
+  content::WebContents* contents = owned.get();
+  BrkWebContents* page = [[BrkWebContents alloc] initWithContents:contents browser:self];
+  page.adopted = YES;
+  [_pages addObject:page];
+  _creatingPage = YES;
+  _browser->GetTabStripModel()->AppendWebContents(std::move(owned), /*foreground=*/false);
+  _creatingPage = NO;
+  return page;
+}
+
+- (id<BrkCoreWebContents>)adoptWebContentsWithURL:(NSURL*)url {
+  const GURL target = net::GURLWithNSURL(url);
+  for (BrkWebContents* page in _unadopted) {
+    if (page.contents && TargetURL(page.contents) == target) {
+      page.adopted = YES;
+      [_unadopted removeObject:page];
+      [_pages addObject:page];
+      return page;
+    }
+  }
+  return nil;
+}
+
+- (void)tabInserted:(content::WebContents*)contents active:(BOOL)active {
+  if (_creatingPage || brkcore::PageForContents(contents)) {
+    return;
+  }
+  // Chromium made this tab itself. The shell decides where it goes, on the next task, outside the tab strip's notification.
+  BrkWebContents* page = [[BrkWebContents alloc] initWithContents:contents browser:self];
+  [_unadopted addObject:page];
+  content::WebContents* openerContents = _browser->GetTabStripModel()->GetActiveWebContents();
+  BrkWebContents* opener = openerContents ? brkcore::PageForContents(openerContents) : nil;
+  const GURL target = TargetURL(contents);
+  __weak BrkBrowser* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    BrkBrowser* strongSelf = weakSelf;
+    if (!strongSelf) {
+      return;
+    }
+    id<BrkCoreWebContentsDelegate> delegate = opener.delegate;
+    [delegate webContents:opener
+          requestsOpening:net::NSURLWithGURL(target)
+              disposition:active ? BrkCoreDispositionForegroundTab : BrkCoreDispositionBackgroundTab
+              userGesture:YES];
+    [strongSelf dropUnadopted:page];
+  });
+}
+
+- (void)dropUnadopted:(BrkWebContents*)page {
+  if ([_unadopted containsObject:page]) {
+    [_unadopted removeObject:page];
+    [page close];
+  }
+}
+
+- (void)activateWebContents:(id<BrkCoreWebContents>)contents {
+  BrkWebContents* page = (BrkWebContents*)contents;
+  if (!_browser || !page.contents) {
+    return;
+  }
+  TabStripModel* strip = _browser->GetTabStripModel();
+  const int index = strip->GetIndexOfWebContents(page.contents);
+  if (index != TabStripModel::kNoTab && strip->active_index() != index) {
+    strip->ActivateTabAt(index);
+  }
+}
+
+- (void)closeContents:(content::WebContents*)contents {
+  if (!_browser) {
+    return;
+  }
+  TabStripModel* strip = _browser->GetTabStripModel();
+  const int index = strip->GetIndexOfWebContents(contents);
+  if (index != TabStripModel::kNoTab) {
+    strip->DetachAndDeleteWebContentsAt(index);
+  }
+}
+
+- (void)pageDidGo:(BrkWebContents*)page {
+  [_pages removeObject:page];
+  [_unadopted removeObject:page];
+}
+
+- (void)browserWillGo {
+  [self closeExtensionPopup];
+  _actionModels.clear();
+  _extensionsContainerData.reset();
+  _extensionsContainer.reset();
+  if (_browser) {
+    _browser->GetTabStripModel()->RemoveObserver(_observer.get());
+  }
+  _browser = nullptr;
+  _window = nullptr;
+}
+
+- (ExtensionActionViewModel*)modelForExtension:(const std::string&)extensionID {
+  if (!_browser) {
+    return nullptr;
+  }
+  Profile* profile = _browser->GetProfile();
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(extensionID);
+  if (!extension || !extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(*extension)) {
+    return nullptr;
+  }
+  auto& model = _actionModels[extensionID];
+  if (!model) {
+    model = ExtensionActionViewModel::Create(extensionID, _browser,
+                                             brkcore::CreateExtensionActionDelegate(self, base::SysUTF8ToNSString(extensionID)));
+  }
+  return model.get();
+}
+
+- (NSString*)executeExtensionAction:(NSString*)extensionID {
+  if (!_browser) {
+    return @"The browser closed";
+  }
+  ExtensionActionViewModel* model = [self modelForExtension:base::SysNSStringToUTF8(extensionID)];
+  if (!model) {
+    return @"The extension has no action here";
+  }
+  content::WebContents* active = _browser->GetTabStripModel()->GetActiveWebContents();
+  if (!active) {
+    return @"No page is active";
+  }
+  if (!model->IsEnabled(active)) {
+    return @"The extension's action is not enabled on this page";
+  }
+  // Only one popup at a time, as in Chrome.
+  [self closeExtensionPopup];
+  model->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  return nil;
+}
+
+- (void)closeExtensionPopup {
+  for (auto& entry : _actionModels) {
+    if (entry.second->IsShowingPopup()) {
+      entry.second->HidePopup();
+    }
+  }
+}
+
+- (void)focusExtensionPopup {
+  for (auto& entry : _actionModels) {
+    brkcore::FocusExtensionPopup(entry.second.get());
+  }
+}
+
+- (void)close {
+  if (_window) {
+    _window->Close();
+  }
+}
+
+@end
