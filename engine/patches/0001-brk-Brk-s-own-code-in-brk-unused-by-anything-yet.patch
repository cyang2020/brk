diff --git a/brk/browser/brk_application.mm b/brk/browser/brk_application.mm
new file mode 100644
index 0000000000000000000000000000000000000000..5f618ded87a7a50a1b019a00502a99a5900690b7
--- /dev/null
+++ b/brk/browser/brk_application.mm
@@ -0,0 +1,122 @@
+#import "brk/browser/brk_application.h"
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/strings/sys_string_conversions.h"
+#include "brk/browser/brk_navigation_throttle.h"
+#import "brk/browser/brk_browser.h"
+#import "brk/browser/brk_profile.h"
+#include "brk/embedding/embedding.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/chrome_browser_application_mac.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "components/keep_alive_registry/keep_alive_types.h"
+#include "components/keep_alive_registry/scoped_keep_alive.h"
+#include "components/version_info/version_info.h"
+
+extern "C" {
+int ChromeMain(int argc, const char** argv);
+}
+
+@implementation BrkApplication {
+  // Brk keeps running with no Browser (a window with no page yet), and profiles stay loaded across that.
+  std::unique_ptr<ScopedKeepAlive> _keepAlive;
+  std::map<std::string, std::unique_ptr<ScopedProfileKeepAlive>> _profileKeepAlives;
+  BOOL _quitting;
+}
+
+- (NSString*)version {
+  return base::SysUTF8ToNSString(std::string(version_info::GetVersionNumber()));
+}
+
+- (int)runWithArguments:(NSArray<NSString*>*)arguments {
+  std::vector<std::string> storage;
+  for (NSString* argument in arguments) {
+    storage.push_back(base::SysNSStringToUTF8(argument));
+  }
+  std::vector<const char*> argv;
+  for (const std::string& argument : storage) {
+    argv.push_back(argument.c_str());
+  }
+  argv.push_back(nullptr);
+  return ChromeMain(static_cast<int>(storage.size()), argv.data());
+}
+
+- (void)loadProfile:(NSString*)directory completion:(void (^)(id<BrkCoreProfile> _Nullable))completion {
+  if (!_keepAlive) {
+    _keepAlive = std::make_unique<ScopedKeepAlive>(KeepAliveOrigin::APP_CONTROLLER, KeepAliveRestartOption::DISABLED);
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  const base::FilePath path = manager->user_data_dir().Append(base::SysNSStringToUTF8(directory));
+  __weak BrkApplication* weakSelf = self;
+  manager->CreateProfileAsync(path, base::BindOnce(^(Profile* profile) {
+    BrkApplication* strongSelf = weakSelf;
+    if (!profile || !strongSelf) {
+      completion(nil);
+      return;
+    }
+    [strongSelf keepProfile:profile];
+    completion([[BrkProfile alloc] initWithProfile:profile]);
+  }));
+}
+
+- (void)keepProfile:(Profile*)profile {
+  auto& keepAlive = _profileKeepAlives[profile->GetPath().value()];
+  if (!keepAlive) {
+    keepAlive = std::make_unique<ScopedProfileKeepAlive>(profile, ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+}
+
+- (void)quit {
+  if (_quitting) {
+    return;
+  }
+  _quitting = YES;
+  _profileKeepAlives.clear();
+  _keepAlive.reset();
+  chrome::ExitIgnoreUnloadHandlers();
+}
+
+@end
+
+namespace brkcore {
+
+namespace {
+BrkApplication* SharedApplication() {
+  static BrkApplication* application = [[BrkApplication alloc] init];
+  return application;
+}
+}  // namespace
+
+void QuitChromium() {
+  [SharedApplication() quit];
+}
+
+}  // namespace brkcore
+
+extern "C" {
+
+__attribute__((visibility("default"))) void BrkCoreApplicationPrepare(void) {
+  brkcore::SetEmbedded();
+  brkcore::Hooks& hooks = brkcore::GetHooks();
+  hooks.create_browser_window = &brkcore::CreateBrowserWindowHook;
+  hooks.update_target_url = &brkcore::UpdateTargetURLHook;
+  hooks.add_navigation_throttles = &brkcore::AddNavigationThrottles;
+  hooks.quit_chromium = &brkcore::QuitChromium;
+  chrome_browser_application_mac::RegisterBrowserCrApp();
+}
+
+__attribute__((visibility("default"))) void* BrkCoreApplicationShared(void) {
+  return (__bridge void*)brkcore::SharedApplication();
+}
+
+}  // extern "C"
