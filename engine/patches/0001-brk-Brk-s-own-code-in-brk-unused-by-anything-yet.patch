diff --git a/brk/BUILD.gn b/brk/BUILD.gn
new file mode 100644
index 0000000000000000000000000000000000000000..30447ded9920c0156fcd98ad6b45c03a45f7ff66
--- /dev/null
+++ b/brk/BUILD.gn
@@ -0,0 +1,53 @@
+# Brk's own code inside the Chromium tree. Linked into BrkCore.framework through //chrome:dependencies.
+
+# What Chromium's own files use to reach Brk: flags and function pointers, no other dependency, so including it never
+# recompiles or relinks anything else.
+source_set("embedding") {
+  sources = [
+    "embedding/embedding.cc",
+    "embedding/embedding.h",
+  ]
+}
+
+source_set("browser") {
+  sources = [
+    "browser/brk_application.h",
+    "browser/brk_application.mm",
+    "browser/brk_browser.h",
+    "browser/brk_browser.mm",
+    "browser/brk_browser_window.h",
+    "browser/brk_browser_window.mm",
+    "browser/brk_devtools_session.cc",
+    "browser/brk_devtools_session.h",
+    "browser/brk_extension_action.h",
+    "browser/brk_extension_action.mm",
+    "browser/brk_location_bar.cc",
+    "browser/brk_location_bar.h",
+    "browser/brk_navigation_throttle.h",
+    "browser/brk_navigation_throttle.mm",
+    "browser/brk_profile.h",
+    "browser/brk_profile.mm",
+    "browser/brk_web_contents.h",
+    "browser/brk_web_contents.mm",
+    "public/BrkCore.h",
+  ]
+  deps = [
+    ":embedding",
+    "//base",
+    "//chrome/browser",
+    "//chrome/browser/extensions",
+    "//chrome/browser/profiles:profile",
+    "//chrome/browser/ui",
+    "//components/keep_alive_registry",
+    "//components/sessions",
+    "//components/zoom",
+    "//content/public/browser",
+    "//extensions/browser",
+    "//extensions/common",
+  ]
+  frameworks = [ "AppKit.framework" ]
+
+  # Chromium's own code has no debug info (engine/args/brk.gn). Brk's has enough for a backtrace.
+  configs -= [ "//build/config/compiler:default_symbols" ]
+  configs += [ "//build/config/compiler:minimal_symbols" ]
+}
