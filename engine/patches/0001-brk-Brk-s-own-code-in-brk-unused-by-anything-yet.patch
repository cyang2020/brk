diff --git a/brk/browser/brk_extension_action.mm b/brk/browser/brk_extension_action.mm
new file mode 100644
index 0000000000000000000000000000000000000000..0349b40be743ac04e5c552b443d72618fb75efbf
--- /dev/null
+++ b/brk/browser/brk_extension_action.mm
@@ -0,0 +1,255 @@
+#import "brk/browser/brk_extension_action.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/notimplemented.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#import "brk/browser/brk_browser.h"
+#include "chrome/browser/extensions/extension_view.h"
+#include "chrome/browser/extensions/extension_view_host.h"
+#include "chrome/browser/ui/extensions/extension_action_delegate.h"
+#include "chrome/browser/ui/extensions/extension_action_view_model.h"
+#include "chrome/browser/ui/extensions/extension_popup_types.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest_handlers/icons_handler.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace brkcore {
+
+namespace {
+
+// Chrome's limits for an action popup (ExtensionPopup::kMinSize, kMaxSize).
+constexpr gfx::Size kMinSize(25, 25);
+constexpr gfx::Size kMaxSize(800, 600);
+
+class BrkExtensionActionDelegate;
+
+// One open popup. Owns the host, so Chromium's ExtensionViewHost and the popup's WebContents live exactly as long as the popup.
+class BrkExtensionPopup : public extensions::ExtensionView {
+ public:
+  BrkExtensionPopup(std::unique_ptr<extensions::ExtensionViewHost> host,
+                    BrkExtensionActionDelegate* delegate,
+                    BrkBrowser* browser,
+                    NSString* extension_id,
+                    ShowPopupCallback callback);
+  ~BrkExtensionPopup() override;
+
+  void Focus() { host_->host_contents()->Focus(); }
+  gfx::NativeView NativeView() { return host_->host_contents()->GetNativeView(); }
+
+  // extensions::ExtensionView:
+  gfx::NativeView GetNativeView() override { return NativeView(); }
+  void ResizeDueToAutoResize(content::WebContents* web_contents, const gfx::Size& new_size) override;
+  void RenderFrameCreated(content::RenderFrameHost* frame) override;
+  bool HandleKeyboardEvent(content::WebContents* source, const input::NativeWebKeyboardEvent& event) override;
+  void OnLoaded() override;
+
+ private:
+  void HostAskedToClose(extensions::ExtensionHost* host);
+
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  const raw_ptr<BrkExtensionActionDelegate> delegate_;
+  __weak BrkBrowser* const browser_;
+  NSString* const extension_id_;
+  // Tells chrome.action.openPopup() the popup is up, or (null) that it never came.
+  ShowPopupCallback callback_;
+  gfx::Size size_ = kMinSize;
+  bool shown_ = false;
+};
+
+class BrkExtensionActionDelegate : public ExtensionActionDelegate {
+ public:
+  BrkExtensionActionDelegate(BrkBrowser* browser, NSString* extension_id)
+      : browser_(browser), extension_id_(extension_id) {}
+
+  void ClosePopup() { popup_.reset(); }
+  void ClosePopupSoon() {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BrkExtensionActionDelegate::ClosePopup, weak_factory_.GetWeakPtr()));
+  }
+  void FocusPopup() {
+    if (popup_) {
+      popup_->Focus();
+    }
+  }
+
+  // ExtensionActionDelegate:
+  void AttachToModel(ExtensionActionViewModel* model) override {}
+  void DetachFromModel() override { popup_.reset(); }
+  void RegisterCommand() override {}
+  void UnregisterCommand() override {}
+  bool IsShowingPopup() const override { return !!popup_; }
+  void HidePopup() override { popup_.reset(); }
+  gfx::NativeView GetPopupNativeViewForTesting() override {
+    return popup_ ? popup_->NativeView() : gfx::NativeView();
+  }
+  void TriggerPopup(std::unique_ptr<extensions::ExtensionViewHost> host,
+                    PopupShowAction show_action,
+                    bool by_user,
+                    ShowPopupCallback callback) override {
+    popup_.reset();
+    popup_ = std::make_unique<BrkExtensionPopup>(std::move(host), this, browser_, extension_id_, std::move(callback));
+  }
+  void ShowContextMenuAsFallback() override {}
+  void CloseExtensionsMenuIfOpen() override {}
+
+ private:
+  __weak BrkBrowser* const browser_;
+  NSString* const extension_id_;
+  std::unique_ptr<BrkExtensionPopup> popup_;
+  base::WeakPtrFactory<BrkExtensionActionDelegate> weak_factory_{this};
+};
+
+BrkExtensionPopup::BrkExtensionPopup(std::unique_ptr<extensions::ExtensionViewHost> host,
+                                     BrkExtensionActionDelegate* delegate,
+                                     BrkBrowser* browser,
+                                     NSString* extension_id,
+                                     ShowPopupCallback callback)
+    : host_(std::move(host)),
+      delegate_(delegate),
+      browser_(browser),
+      extension_id_(extension_id),
+      callback_(std::move(callback)) {
+  host_->set_view(this);
+  host_->SetCloseHandler(base::BindOnce(&BrkExtensionPopup::HostAskedToClose, base::Unretained(this)));
+  host_->CreateRendererSoon();
+}
+
+BrkExtensionPopup::~BrkExtensionPopup() {
+  if (callback_) {
+    std::move(callback_).Run(nullptr);
+  }
+  host_->set_view(nullptr);
+  BrkBrowser* browser = browser_;
+  if (shown_) {
+    [browser.delegate browser:browser didCloseExtensionPopup:extension_id_];
+  }
+}
+
+void BrkExtensionPopup::ResizeDueToAutoResize(content::WebContents*, const gfx::Size& new_size) {
+  size_ = new_size;
+  size_.SetToMax(kMinSize);
+  size_.SetToMin(kMaxSize);
+  if (shown_) {
+    BrkBrowser* browser = browser_;
+    [browser.delegate browser:browser
+        didResizeExtensionPopup:extension_id_
+                           size:NSMakeSize(size_.width(), size_.height())];
+  }
+}
+
+void BrkExtensionPopup::RenderFrameCreated(content::RenderFrameHost* frame) {
+  if (frame->IsInPrimaryMainFrame() && frame->GetView()) {
+    frame->GetView()->EnableAutoResize(kMinSize, kMaxSize);
+  }
+}
+
+bool BrkExtensionPopup::HandleKeyboardEvent(content::WebContents*, const input::NativeWebKeyboardEvent& event) {
+  if (event.windows_key_code == ui::VKEY_ESCAPE && event.GetType() != blink::WebInputEvent::Type::kKeyUp) {
+    delegate_->ClosePopupSoon();
+    return true;
+  }
+  return false;
+}
+
+void BrkExtensionPopup::OnLoaded() {
+  if (shown_) {
+    return;
+  }
+  shown_ = true;
+  BrkBrowser* browser = browser_;
+  [browser.delegate browser:browser
+      didOpenExtensionPopup:extension_id_
+                       view:host_->host_contents()->GetNativeView().GetNativeNSView()];
+  [browser.delegate browser:browser
+      didResizeExtensionPopup:extension_id_
+                         size:NSMakeSize(size_.width(), size_.height())];
+  if (callback_) {
+    std::move(callback_).Run(host_.get());
+  }
+}
+
+void BrkExtensionPopup::HostAskedToClose(extensions::ExtensionHost*) {
+  delegate_->ClosePopupSoon();
+}
+
+}  // namespace
+
+std::unique_ptr<ExtensionActionDelegate> CreateExtensionActionDelegate(BrkBrowser* browser, NSString* extensionID) {
+  return std::make_unique<BrkExtensionActionDelegate>(browser, extensionID);
+}
+
+void FocusExtensionPopup(ExtensionActionViewModel* model) {
+  // The view model owns its delegate and does not hand it out; the only delegates it can have here are Brk's.
+  static_cast<BrkExtensionActionDelegate*>(model->delegate())->FocusPopup();
+}
+
+}  // namespace brkcore
+
+@implementation BrkExtension {
+  NSString* _extensionID;
+  NSString* _name;
+  NSString* _version;
+  NSData* _iconData;
+  BOOL _enabled;
+  BOOL _hasAction;
+}
+
+- (instancetype)initWithExtension:(const extensions::Extension*)extension
+                          enabled:(BOOL)enabled
+                        hasAction:(BOOL)hasAction {
+  if ((self = [super init])) {
+    _extensionID = base::SysUTF8ToNSString(extension->id());
+    _name = base::SysUTF8ToNSString(extension->name());
+    _version = base::SysUTF8ToNSString(extension->VersionString());
+    _enabled = enabled;
+    _hasAction = hasAction;
+    const std::string relative =
+        extensions::IconsInfo::GetIcons(extension).Get(extension_misc::EXTENSION_ICON_SMALL, ExtensionIconSet::Match::kBigger);
+    if (!relative.empty()) {
+      _iconData = [NSData
+          dataWithContentsOfFile:base::SysUTF8ToNSString(extension->path().AppendASCII(relative).value())];
+    }
+  }
+  return self;
+}
+
+- (NSString*)extensionID {
+  return _extensionID;
+}
+
+- (NSString*)name {
+  return _name;
+}
+
+- (NSString*)version {
+  return _version;
+}
+
+- (BOOL)enabled {
+  return _enabled;
+}
+
+- (BOOL)hasAction {
+  return _hasAction;
+}
+
+- (NSData*)iconData {
+  return _iconData;
+}
+
+@end
