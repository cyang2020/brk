+// Chrome's fullscreen and pointer lock state talks to this. Page fullscreen does not reach the shell yet (see
+// docs/chromium/ARC-ENGINE.md), so the context says it cannot enter.
+class BrkExclusiveAccessContext : public ExclusiveAccessContext {
+ public:
+  explicit BrkExclusiveAccessContext(BrowserWindowInterface* browser) : browser_(browser) {}
+
+  Profile* GetProfile() override { return browser_->GetProfile(); }
+  bool IsFullscreen() const override { return false; }
+  void EnterFullscreen(const url::Origin& origin,
+                       ExclusiveAccessBubbleType bubble_type,
+                       FullscreenTabParams fullscreen_tab_params) override {}
+  void ExitFullscreen() override {}
+  void UpdateExclusiveAccessBubble(const ExclusiveAccessBubbleParams& params,
+                                   ExclusiveAccessBubbleHideCallback first_hide_callback) override {
+    if (first_hide_callback) {
+      std::move(first_hide_callback).Run(ExclusiveAccessBubbleHideReason::kNotShown);
+    }
+  }
+  bool IsExclusiveAccessBubbleDisplayed() const override { return false; }
+  void OnExclusiveAccessUserInput() override {}
+  content::WebContents* GetWebContentsForExclusiveAccess() override {
+    return browser_->GetTabStripModel()->GetActiveWebContents();
+  }
+  bool CanUserEnterFullscreen() const override { return false; }
+  bool CanUserExitFullscreen() const override { return true; }
+
+ private:
+  const raw_ptr<BrowserWindowInterface> browser_;
+};
+
+BrkBrowserWindow::BrkBrowserWindow(BrowserWindowInterface* browser, BrkBrowser* owner)
+    : browser_(browser),
+      owner_(owner),
+      location_bar_(std::make_unique<BrkLocationBar>(browser)),
+      exclusive_access_context_(std::make_unique<BrkExclusiveAccessContext>(browser)) {}
+
+BrkBrowserWindow::~BrkBrowserWindow() {
+  SetNativeWindow(nil);
+  browser_->GetFeatures().TearDownPreBrowserWindowDestruction();
+}
+
+void BrkBrowserWindow::SetNativeWindow(NSWindow* window) {
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  if (key_observer_) {
+    [center removeObserver:key_observer_];
+    [center removeObserver:resign_observer_];
+    key_observer_ = nil;
+    resign_observer_ = nil;
+  }
+  window_ = window;
+  if (!window) {
+    return;
+  }
+  BrowserWindowInterface* browser = browser_;
+  key_observer_ = [center addObserverForName:NSWindowDidBecomeKeyNotification
+                                      object:window
+                                       queue:nil
+                                  usingBlock:^(NSNotification*) {
+                                    BrowserActiveStateManager::From(browser)->DidBecomeActive();
+                                  }];
+  resign_observer_ = [center addObserverForName:NSWindowDidResignKeyNotification
+                                         object:window
+                                          queue:nil
+                                     usingBlock:^(NSNotification*) {
+                                       BrowserActiveStateManager::From(browser)->DidBecomeInactive();
+                                     }];
+  if (window.isKeyWindow) {
+    BrowserActiveStateManager::From(browser_)->DidBecomeActive();
+  }
+}
