+- (id<BrkCoreBrowser>)createBrowserForWindow:(NSWindow*)window delegate:(id<BrkCoreBrowserDelegate>)delegate {
+  return [[BrkBrowser alloc] initWithProfile:_profile.get() window:window delegate:delegate];
+}
+
+- (id<BrkCoreProfile>)incognitoProfile {
+  Profile* incognito = _profile->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  return [[BrkProfile alloc] initWithProfile:incognito];
+}
+
+- (void)whenExtensionsReady:(void (^)(void))completion {
+  if (!_profile) {
+    completion();
+    return;
+  }
+  extensions::ExtensionSystem::Get(_profile.get())->ready().Post(FROM_HERE, base::BindOnce(^{
+    completion();
+  }));
+}
+
+- (NSArray<id<BrkCoreExtension>>*)installedExtensions {
+  NSMutableArray<id<BrkCoreExtension>>* out = [NSMutableArray array];
+  if (!_profile) {
+    return out;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(_profile.get());
+  auto* actions = extensions::ExtensionActionManager::Get(_profile.get());
+  auto add = [&](const extensions::ExtensionSet& set, BOOL enabled) {
+    for (const auto& extension : set) {
+      if (extensions::Manifest::IsComponentLocation(extension->location())) {
+        continue;
+      }
+      [out addObject:[[BrkExtension alloc] initWithExtension:extension.get()
+                                                     enabled:enabled
+                                                   hasAction:actions->GetExtensionAction(*extension) != nullptr]];
+    }
+  };
+  add(registry->enabled_extensions(), YES);
+  add(registry->disabled_extensions(), NO);
+  return out;
+}
+
+- (void)installUnpackedExtensionAtPath:(NSString*)path
+                            completion:(void (^)(NSString* _Nullable, NSString* _Nullable))completion {
+  if (!_profile) {
+    completion(nil, @"The profile closed");
+    return;
+  }
+  scoped_refptr<extensions::UnpackedInstaller> installer = extensions::UnpackedInstaller::Create(_profile.get());
+  installer->set_be_noisy_on_failure(false);
+  installer->set_completion_callback(base::BindOnce(
+      [](void (^completion)(NSString*, NSString*), const extensions::Extension* extension, const base::FilePath&,
+         const std::u16string& error) {
+        if (extension) {
+          completion(base::SysUTF8ToNSString(extension->id()), nil);
+        } else {
+          completion(nil, error.empty() ? @"The extension did not load" : base::SysUTF16ToNSString(error));
+        }
+      },
+      completion));
+  installer->Load(base::FilePath(base::SysNSStringToUTF8(path)));
+}
+
+@end
