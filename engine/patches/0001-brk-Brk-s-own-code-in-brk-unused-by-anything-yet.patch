+
+- (BOOL)decideNavigationTo:(const GURL&)url isRedirect:(BOOL)isRedirect userGesture:(BOOL)userGesture {
+  id<BrkCoreWebContentsDelegate> delegate = _delegate;
+  return !delegate || [delegate webContents:self
+                         decideNavigationTo:net::NSURLWithGURL(url)
+                                 isRedirect:isRedirect
+                                userGesture:userGesture];
+}
+
+- (BrkCoreKeyPress)pressFromEvent:(const input::NativeWebKeyboardEvent&)event {
+  BrkCoreKeyPress press{};
+  press.nativeKeyCode = event.native_key_code;
+  NSEvent* native = event.os_event.Get();
+  press.modifierFlags = native ? native.modifierFlags : FlagsFromModifiers(event.GetModifiers());
+  press.isDown = event.GetType() != blink::WebInputEvent::Type::kKeyUp;
+  press.isRepeat = (event.GetModifiers() & blink::WebInputEvent::kIsAutoRepeat) != 0;
+  press.editableFocused = _contents && _contents->IsFocusedElementEditable();
+  press.timestamp = native ? native.timestamp : 0;
+  return press;
+}
+
+- (BrkCoreKeyAnswer)keyBeforePage:(const input::NativeWebKeyboardEvent&)event {
+  id<BrkCoreWebContentsDelegate> delegate = _delegate;
+  if (!delegate || event.GetType() == blink::WebInputEvent::Type::kChar) {
+    return BrkCoreKeyAnswer{false, false};
+  }
+  return [delegate webContents:self keyBeforePage:[self pressFromEvent:event]];
+}
+
+- (BOOL)keyAfterPage:(const input::NativeWebKeyboardEvent&)event {
+  id<BrkCoreWebContentsDelegate> delegate = _delegate;
+  if (!delegate || event.GetType() == blink::WebInputEvent::Type::kChar) {
+    return NO;
+  }
+  return [delegate webContents:self keyAfterPage:[self pressFromEvent:event]];
+}
+
+- (void)hoverLink:(const GURL&)url {
+  [_delegate webContents:self didHoverLink:url.is_empty() ? nil : NSURLFromGURL(url)];
+}
+
+@end
+
+namespace {
+void BrkPage::WebContentsDestroyed() {
+  [owner_ contentsWillGo:closing_by_shell_];
+}
+}  // namespace
