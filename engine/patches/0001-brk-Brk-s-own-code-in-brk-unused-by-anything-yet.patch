diff --git a/brk/embedding/embedding.h b/brk/embedding/embedding.h
new file mode 100644
index 0000000000000000000000000000000000000000..b262a90edf9ba03d937166e4915c743c65d0ab15
--- /dev/null
+++ b/brk/embedding/embedding.h
@@ -0,0 +1,37 @@
+// What Chromium's own files use to reach Brk's code. It has no dependencies, so the few files patched to include it need nothing
+// else, and every entry is empty unless BrkCore.framework was started through BrkCoreApplicationPrepare. Then Chromium behaves as
+// plain Chromium, which is what lets `chrome` still be built and run from the same tree.
+
+#ifndef BRK_EMBEDDING_EMBEDDING_H_
+#define BRK_EMBEDDING_EMBEDDING_H_
+
+class BrowserWindow;
+class BrowserWindowInterface;
+class GURL;
+
+namespace content {
+class NavigationThrottleRegistry;
+class WebContents;
+}  // namespace content
+
+namespace brkcore {
+
+struct Hooks {
+  // Makes the window object of a Browser that Brk is creating. Null for every other Browser: DevTools windows and popups a page opens
+  // stay Chrome's own.
+  BrowserWindow* (*create_browser_window)(BrowserWindowInterface* browser) = nullptr;
+  // True when the status text went to Brk instead of Chrome's status bubble.
+  bool (*update_target_url)(content::WebContents* source, const GURL& url) = nullptr;
+  void (*add_navigation_throttles)(content::NavigationThrottleRegistry& registry) = nullptr;
+  // The shell agreed to quit. Runs Chromium's own shutdown; the run loop stops when that is done.
+  void (*quit_chromium)() = nullptr;
+};
+
+// True when BrkCore.framework was started by Brk's shell: the shell owns NSApp's delegate, the menu and the quit.
+bool IsEmbedded();
+void SetEmbedded();
+Hooks& GetHooks();
+
+}  // namespace brkcore
+
+#endif  // BRK_EMBEDDING_EMBEDDING_H_
