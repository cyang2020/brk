+    _extensionObserver = std::make_unique<brkcore::ProfileExtensionObserver>(self, _profile.get());
+  }
+}
+
+- (void)extensionRegistryChanged {
+  if (_extensionChangePending) {
+    return;
+  }
+  _extensionChangePending = YES;
+  __weak BrkProfile* weakSelf = self;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(^{
+    BrkProfile* owner = weakSelf;
+    if (!owner) {
+      return;
+    }
+    owner->_extensionChangePending = NO;
+    if (owner->_profile && owner->_extensionsChangedHandler) {
+      owner->_extensionsChangedHandler();
+    }
+  }));
