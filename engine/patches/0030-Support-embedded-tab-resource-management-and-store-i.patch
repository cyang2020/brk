+  BrkWebContents* page = (BrkWebContents*)contents;
+  BrkBrowser* source = page.browser;
+  if (!source || !_browser || !source->_browser || !page.contents) return NO;
+  if (source == self) return YES;
+  if (_browser->GetProfile() != source->_browser->GetProfile()) return NO;
+  TabStripModel* oldStrip = source->_browser->GetTabStripModel();
+  const int index = oldStrip->GetIndexOfWebContents(page.contents);
+  if (index == TabStripModel::kNoTab) return NO;
+  std::unique_ptr<tabs::TabModel> tab = oldStrip->DetachTabAtForInsertion(index);
