+}
+
+- (BOOL)setFreezingMode:(BrkCoreFreezingMode)mode {
+  if (!_contents || _discarded) return NO;
+  BrkPage* bridge = BrkPage::FromWebContents(_contents);
+  if (!bridge) return NO;
+  if (mode == BrkCoreFreezingModeActive) {
+    bridge->SetFreezingVote(false);
+    _contents->SetPageFrozen(false);
+    return YES;
+  }
+  using namespace performance_manager;
+  if (_contents->GetVisibility() != content::Visibility::HIDDEN ||
+      !PerformanceManager::IsAvailable()) return NO;
+  auto node = PerformanceManager::GetPrimaryPageNodeForWebContents(_contents);
+  auto* graph = PerformanceManager::GetGraph();
+  if (!node || !FreezingPolicy::GetFromGraph(graph)) return NO;
+  if (mode == BrkCoreFreezingModeUserRequested) {
+    auto details = freezing::GetCanFreezeDetailsForPageNode(node.get());
+    auto reasons = details.cannot_freeze_reasons;
+    reasons.PutAll(details.cannot_freeze_reasons_connected_pages);
+    reasons.Remove(freezing::CannotFreezeReason::kRecentlyVisible);
+    reasons.Remove(freezing::CannotFreezeReason::kRecentlyAudible);
+    reasons.Remove(freezing::CannotFreezeReason::kMostRecentlyUsed);
+    if (!reasons.empty()) {
+      bridge->SetFreezingVote(false);
+      _contents->SetPageFrozen(false);
+      return NO;
+    }
+  }
+  bridge->SetFreezingVote(true);
+  if (mode == BrkCoreFreezingModeUserRequested) _contents->SetPageFrozen(true);
+  return YES;
+}
+
+- (BOOL)pageFrozen {
+  if (!_contents || !performance_manager::PerformanceManager::IsAvailable()) return NO;
+  auto node = performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(_contents);
+  return node && node->GetLifecycleState() == performance_manager::mojom::LifecycleState::kFrozen;
+}
+
+- (BOOL)discarded { return _discarded; }
+
+- (uint64_t)estimatedMemoryBytes {
+  if (!_contents || !performance_manager::PerformanceManager::IsAvailable()) return 0;
+  auto node = performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(_contents);
+  return node ? performance_manager::user_tuning::GetDiscardedMemoryEstimateForPage(node.get()).InBytes() : 0;
+}
+
+- (BOOL)discardIfEligible {
+  if (!_contents || _discarded || _contents->IsCurrentlyAudible() || _contents->IsBeingCaptured() ||
+      _contents->GetVisibility() != content::Visibility::HIDDEN ||
+      !performance_manager::PerformanceManager::IsAvailable()) return NO;
+  using namespace performance_manager;
+  auto node = PerformanceManager::GetPrimaryPageNodeForWebContents(_contents);
+  auto* graph = PerformanceManager::GetGraph();
+  auto* policy = policies::DiscardEligibilityPolicy::GetFromGraph(graph);
+  auto* helper = policies::PageDiscardingHelper::GetFromGraph(graph);
+  constexpr auto reason = ::mojom::LifecycleUnitDiscardReason::PROACTIVE;
+  if (!node || !policy || !helper) return NO;
+  std::vector<policies::CannotDiscardReason> reasons;
+  const auto eligibility = policy->CanDiscard(node.get(), reason, false, &reasons);
+  bool detached = false;
+  if (eligibility != policies::CanDiscardResult::kEligible) {
+    // The shell keeps emulation and filtering in its protocol session. It is
+    // not a user's debugger: detach it only when it is the sole veto, then let
+    // Chromium check again so a real debugger remains protected.
+    if (reasons.empty() || !std::all_of(reasons.begin(), reasons.end(), [](auto value) {
+          return value == policies::CannotDiscardReason::kDevToolsOpen;
+        })) return NO;
+    auto* bridge = BrkPage::FromWebContents(_contents);
+    if (!bridge || !bridge->ReleaseIdleDevToolsForDiscard()) return NO;
+    detached = true;
+  }
+  if (policy->CanDiscard(node.get(), reason) == policies::CanDiscardResult::kEligible &&
+      helper->ImmediatelyDiscardMultiplePages({node.get()}, reason, false)) return YES;
+  if (detached && [_delegate respondsToSelector:@selector(webContentsProtocolStateInvalidated:)]) {
+    [_delegate webContentsProtocolStateInvalidated:self];
+  }
+  return NO;
+}
+
+- (void)resumeIfDiscarded {
+  if (!_contents || !_discarded) return;
+  _discarded = NO;
+  _contents->GetController().SetNeedsReload();
+  _contents->GetController().LoadIfNecessary();
+}
+
+- (void)replaceDiscardedContents:(content::WebContents*)replacement {
+  BrkPage* old = _contents ? BrkPage::FromWebContents(_contents) : nullptr;
+  if (old) old->DetachOwner();
+  brkcore::CancelPageDialog(_contents);
+  _contents = replacement;
+  _discarded = YES;
+  BrkPage::CreateForWebContents(replacement, self);
+  brkcore::WatchMediaPlayers(replacement, self);
+  for (NSView* child in [_nativeView.subviews copy]) [child removeFromSuperview];
+  NSView* child = replacement->GetNativeView().GetNativeNSView();
+  child.frame = _nativeView.bounds;
+  child.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [_nativeView addSubview:child];
+}
+
+- (void)didDiscardContents {
+  _discarded = YES;
+  if (auto* bridge = BrkPage::FromWebContents(_contents)) bridge->SetFreezingVote(false);
+  [self tabHelpersReady];
+  if ([_delegate respondsToSelector:@selector(webContentsWasDiscarded:)]) {
+    [_delegate webContentsWasDiscarded:self];
   }
 }
 
