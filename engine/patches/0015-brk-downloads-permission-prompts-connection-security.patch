index 0000000000000000000000000000000000000000..08733a081c051600f3c68065fedd1fdd4c4786e6
--- /dev/null
+++ b/brk/browser/brk_downloads.h
@@ -0,0 +1,14 @@
+#ifndef BRK_BROWSER_BRK_DOWNLOADS_H_
+#define BRK_BROWSER_BRK_DOWNLOADS_H_
+
+#include "brk/embedding/embedding.h"
+
+namespace brkcore {
+
+// Installed in brkcore::Hooks: a download one of Brk's pages started gets its destination from the shell, as CEF's OnBeforeDownload
+// gives it, instead of from Chrome's download prefs and file chooser. Every other download stays Chrome's.
+bool DetermineDownloadTargetHook(download::DownloadItem* item, BrkDownloadTargetCallback* callback);
+
+}  // namespace brkcore
+
+#endif  // BRK_BROWSER_BRK_DOWNLOADS_H_
diff --git a/brk/browser/brk_downloads.mm b/brk/browser/brk_downloads.mm
new file mode 100644
index 0000000000000000000000000000000000000000..6fb2f22a1410be0d284d191cc364e2b5b86c2fdd
--- /dev/null
+++ b/brk/browser/brk_downloads.mm
@@ -0,0 +1,230 @@
+#import "brk/browser/brk_downloads.h"
+
+#import <Foundation/Foundation.h>
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#import "brk/browser/brk_web_contents.h"
+#include "brk/public/BrkCore.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/download/public/common/download_item.h"
+#include "components/download/public/common/download_target_info.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/download_item_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/apple/url_conversions.h"
+#include "net/base/filename_util.h"
+
+@class BrkDownload;
+
+namespace {
+
+// Every download the shell was told about, until Chromium drops its item. The shell holds them only while it cares.
+NSMutableSet<BrkDownload*>* LiveDownloads() {
+  static NSMutableSet<BrkDownload*>* set = [NSMutableSet set];
+  return set;
+}
+
+}  // namespace
+
+@interface BrkDownload : NSObject <BrkCoreDownload>
+- (instancetype)initWithItem:(download::DownloadItem*)item
+                        page:(BrkWebContents*)page
+               suggestedName:(NSString*)suggestedName
+                    callback:(brkcore::BrkDownloadTargetCallback)callback;
+- (void)itemUpdated;
+- (void)itemDestroyed;
+@end
+
+namespace brkcore {
+namespace {
+
+class BrkDownloadObserver : public download::DownloadItem::Observer {
+ public:
+  BrkDownloadObserver(download::DownloadItem* item, BrkDownload* owner) : item_(item), owner_(owner) {
+    item_->AddObserver(this);
+  }
+  ~BrkDownloadObserver() override {
+    if (item_) {
+      item_->RemoveObserver(this);
+    }
+  }
+
+  void OnDownloadUpdated(download::DownloadItem* item) override { [owner_ itemUpdated]; }
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    item_->RemoveObserver(this);
+    item_ = nullptr;
+    [owner_ itemDestroyed];
+  }
+
+ private:
+  raw_ptr<download::DownloadItem> item_;
+  __weak BrkDownload* const owner_;
+};
+
+}  // namespace
+}  // namespace brkcore
+
+@implementation BrkDownload {
+  raw_ptr<download::DownloadItem> _item;
+  __weak BrkWebContents* _page;
+  NSString* _suggestedName;
+  uint32_t _downloadID;
+  brkcore::BrkDownloadTargetCallback _callback;
+  std::unique_ptr<brkcore::BrkDownloadObserver> _observer;
+  BOOL _reportedTerminal;
+}
+
+- (instancetype)initWithItem:(download::DownloadItem*)item
+                        page:(BrkWebContents*)page
+               suggestedName:(NSString*)suggestedName
+                    callback:(brkcore::BrkDownloadTargetCallback)callback {
+  if ((self = [super init])) {
+    _item = item;
+    _page = page;
+    _suggestedName = [suggestedName copy];
+    _downloadID = item->GetId();
+    _callback = std::move(callback);
+    _observer = std::make_unique<brkcore::BrkDownloadObserver>(item, self);
+  }
+  return self;
+}
+
+- (uint32_t)downloadID {
+  return _downloadID;
+}
+
+- (NSURL*)url {
+  return _item && _item->GetURL().is_valid() ? net::NSURLWithGURL(_item->GetURL()) : nil;
+}
+
+- (NSString*)suggestedName {
+  return _suggestedName;
+}
+
+- (int64_t)receivedBytes {
+  return _item ? _item->GetReceivedBytes() : 0;
+}
+
+- (int64_t)totalBytes {
+  return _item ? std::max<int64_t>(0, _item->GetTotalBytes()) : 0;
+}
+
+- (BOOL)isComplete {
+  return _item && _item->GetState() == download::DownloadItem::COMPLETE;
+}
+
+- (BOOL)isCanceled {
+  return !_item || _item->GetState() == download::DownloadItem::CANCELLED;
+}
+
+- (BOOL)isInterrupted {
+  return _item && _item->GetState() == download::DownloadItem::INTERRUPTED;
+}
+
+- (NSInteger)interruptionReason {
+  return _item ? static_cast<NSInteger>(_item->GetLastReason()) : 0;
+}
+
+- (NSString*)fullPath {
+  return _item && !_item->GetFullPath().empty() ? base::SysUTF8ToNSString(_item->GetFullPath().value()) : nil;
+}
+
+- (void)continueToPath:(NSString*)path {
+  if (_callback.is_null()) {
+    return;
+  }
+  download::DownloadTargetInfo target;
+  if (path.length) {
+    // As CEF: the file is written where the shell said, under that name from the first byte, with no renaming and nothing judged
+    // dangerous. The shell's own staging folder is what keeps a partial file apart.
+    target.target_path = base::FilePath(base::SysNSStringToUTF8(path));
+    target.intermediate_path = target.target_path;
+    target.display_name = target.target_path.BaseName();
+    target.target_disposition = download::DownloadItem::TARGET_DISPOSITION_OVERWRITE;
+    target.danger_type = download::DOWNLOAD_DANGER_TYPE_NOT_DANGEROUS;
+    target.insecure_download_status = download::DownloadItem::InsecureDownloadStatus::SAFE;
+    if (_item) {
+      target.mime_type = _item->GetMimeType();
+    }
+  } else {
+    target.interrupt_reason = download::DOWNLOAD_INTERRUPT_REASON_USER_CANCELED;
+  }
+  std::move(_callback).Run(std::move(target));
+}
+
+- (void)cancel {
+  if (!_callback.is_null()) {
+    [self continueToPath:nil];
+    return;
+  }
+  if (_item && !_item->IsDone()) {
+    _item->Cancel(/*user_cancel=*/true);
+  }
+}
+
+- (void)itemUpdated {
+  if (_reportedTerminal) {
+    return;
+  }
+  BrkWebContents* page = _page;
+  id<BrkCoreWebContentsDelegate> delegate = page.delegate;
+  const bool done = !_item || _item->IsDone() || _item->GetState() == download::DownloadItem::INTERRUPTED;
+  if (done) {
+    _reportedTerminal = YES;
+  }
+  if (page && [delegate respondsToSelector:@selector(webContents:downloadDidUpdate:)]) {
+    [delegate webContents:page downloadDidUpdate:self];
+  }
+}
+
+- (void)itemDestroyed {
+  _item = nullptr;
+  _observer.reset();
+  _callback.Reset();
+  [self itemUpdated];
+  [LiveDownloads() removeObject:self];
+}
+
+@end
+
+namespace brkcore {
+
+bool DetermineDownloadTargetHook(download::DownloadItem* item, BrkDownloadTargetCallback* callback) {
+  content::WebContents* contents = content::DownloadItemUtils::GetWebContents(item);
+  BrkWebContents* page = contents ? PageForContents(contents) : nil;
+  id<BrkCoreWebContentsDelegate> delegate = page.delegate;
+  if (!page || ![delegate respondsToSelector:@selector(webContents:willDownload:)]) {
+    return false;
+  }
+  // A path forced by the caller (Save Page As, an extension's download with a file name) is kept, as CEF keeps it.
+  if (!item->GetForcedFilePath().empty()) {
+    download::DownloadTargetInfo target;
+    target.target_path = item->GetForcedFilePath();
+    target.intermediate_path = target.target_path;
+    std::move(*callback).Run(std::move(target));
+    return true;
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  const base::FilePath name = net::GenerateFileName(item->GetURL(), item->GetContentDisposition(),
+                                                    profile->GetPrefs()->GetString(prefs::kDefaultCharset),
+                                                    item->GetSuggestedFilename(), item->GetMimeType(), "download");
+  BrkDownload* download = [[BrkDownload alloc] initWithItem:item
+                                                       page:page
+                                              suggestedName:base::SysUTF8ToNSString(name.value())
+                                                   callback:std::move(*callback)];
+  [LiveDownloads() addObject:download];
+  [delegate webContents:page willDownload:download];
+  return true;
+}
+
+}  // namespace brkcore
