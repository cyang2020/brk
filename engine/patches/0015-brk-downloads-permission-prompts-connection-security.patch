+++ b/brk/browser/brk_javascript_dialogs.mm
@@ -0,0 +1,233 @@
+#include "brk/browser/brk_javascript_dialogs.h"
+
+#import <Foundation/Foundation.h>
+
+#include <string>
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#import "brk/browser/brk_web_contents.h"
+#include "brk/public/BrkCore.h"
+#include "components/url_formatter/elide_url.h"
+#include "content/public/browser/javascript_dialog_manager.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/javascript_dialog_type.h"
+#include "url/origin.h"
+
+using DialogClosedCallback = content::JavaScriptDialogManager::DialogClosedCallback;
+
+@interface BrkDialog : NSObject <BrkCoreDialog>
+- (instancetype)initWithKind:(BrkCoreDialogKind)kind
+                     message:(NSString*)message
+           defaultPromptText:(NSString*)defaultPromptText
+                 originTitle:(NSString*)originTitle
+                    isReload:(BOOL)isReload
+                    callback:(DialogClosedCallback)callback;
+@property(nonatomic, readonly) BOOL answered;
+// The page it is open on, which forgets it once it is answered.
+@property(nonatomic, weak) BrkWebContents* owner;
+- (void)drop;
+@end
+
+@implementation BrkDialog {
+  __weak BrkWebContents* _owner;
+  BrkCoreDialogKind _kind;
+  NSString* _message;
+  NSString* _defaultPromptText;
+  NSString* _originTitle;
+  BOOL _isReload;
+  DialogClosedCallback _callback;
+}
+
+- (instancetype)initWithKind:(BrkCoreDialogKind)kind
+                     message:(NSString*)message
+           defaultPromptText:(NSString*)defaultPromptText
+                 originTitle:(NSString*)originTitle
+                    isReload:(BOOL)isReload
+                    callback:(DialogClosedCallback)callback {
+  if ((self = [super init])) {
+    _kind = kind;
+    _message = [message copy];
+    _defaultPromptText = [defaultPromptText copy];
+    _originTitle = [originTitle copy];
+    _isReload = isReload;
+    _callback = std::move(callback);
+  }
+  return self;
+}
+
+@synthesize owner = _owner;
+
+- (BrkCoreDialogKind)kind {
+  return _kind;
+}
+
+- (NSString*)message {
+  return _message;
+}
+
+- (NSString*)defaultPromptText {
+  return _defaultPromptText;
+}
+
+- (NSString*)originTitle {
+  return _originTitle;
+}
+
+- (BOOL)isReload {
+  return _isReload;
+}
+
+- (BOOL)answered {
+  return _callback.is_null();
+}
+
+- (void)answer:(BOOL)accepted text:(NSString*)text {
+  if (_callback.is_null()) {
+    return;
+  }
+  BrkWebContents* owner = _owner;
+  if (owner.openDialog == self) {
+    owner.openDialog = nil;
+  }
+  std::move(_callback).Run(accepted, accepted && text ? base::SysNSStringToUTF16(text) : std::u16string());
+}
+
+- (void)drop {
+  _callback.Reset();
+}
+
+@end
