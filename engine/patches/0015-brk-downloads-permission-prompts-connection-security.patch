+namespace brkcore {
+
+namespace {
+
+BrkCoreDialogKind KindOf(content::JavaScriptDialogType type) {
+  switch (type) {
+    case content::JAVASCRIPT_DIALOG_TYPE_ALERT:
+      return BrkCoreDialogKindAlert;
+    case content::JAVASCRIPT_DIALOG_TYPE_CONFIRM:
+      return BrkCoreDialogKindConfirm;
+    case content::JAVASCRIPT_DIALOG_TYPE_PROMPT:
+      return BrkCoreDialogKindPrompt;
+  }
+  return BrkCoreDialogKindAlert;
+}
+
+// What Chrome titles the dialog with: the frame's origin, "site.test says".
+NSString* OriginTitle(content::RenderFrameHost* frame) {
+  const url::Origin origin = frame ? frame->GetLastCommittedOrigin() : url::Origin();
+  if (origin.opaque()) {
+    return @"This page says";
+  }
+  const std::u16string host =
+      url_formatter::FormatOriginForSecurityDisplay(origin, url_formatter::SchemeDisplay::OMIT_HTTP_AND_HTTPS);
+  return [base::SysUTF16ToNSString(host) stringByAppendingString:@" says"];
+}
+
+// One per process: the dialogs belong to the BrkWebContents they were asked on, which the shell answers.
+class BrkJavaScriptDialogManager : public content::JavaScriptDialogManager {
+ public:
+  void RunJavaScriptDialog(content::WebContents* web_contents,
+                           content::RenderFrameHost* render_frame_host,
+                           content::JavaScriptDialogType dialog_type,
+                           const std::u16string& message_text,
+                           const std::u16string& default_prompt_text,
+                           DialogClosedCallback callback,
+                           bool* did_suppress_message) override {
+    BrkDialog* dialog = [[BrkDialog alloc] initWithKind:KindOf(dialog_type)
+                                                message:base::SysUTF16ToNSString(message_text)
+                                      defaultPromptText:base::SysUTF16ToNSString(default_prompt_text)
+                                            originTitle:OriginTitle(render_frame_host)
+                                               isReload:NO
+                                               callback:std::move(callback)];
+    if (!Show(web_contents, dialog)) {
+      // As Chrome does for a page that may not show one: the page goes on as if it was dismissed.
+      [dialog drop];
+      *did_suppress_message = true;
+    }
+  }
+
+  void RunBeforeUnloadDialog(content::WebContents* web_contents,
+                             content::RenderFrameHost* render_frame_host,
+                             bool is_reload,
+                             DialogClosedCallback callback) override {
+    BrkDialog* dialog = [[BrkDialog alloc] initWithKind:BrkCoreDialogKindBeforeUnload
+                                                message:@""
+                                      defaultPromptText:@""
+                                            originTitle:OriginTitle(render_frame_host)
+                                               isReload:is_reload
+                                               callback:std::move(callback)];
+    if (!Show(web_contents, dialog)) {
+      // Nobody to ask: the page is left, as Chrome leaves it when it cannot show the question.
+      [dialog answer:YES text:nil];
+    }
+  }
+
+  bool HandleJavaScriptDialog(content::WebContents* web_contents,
+                              bool accept,
+                              const std::u16string* prompt_override) override {
+    // DevTools' Page.handleJavaScriptDialog: answers the page's open dialog as the shell would.
+    BrkWebContents* page = PageForContents(web_contents);
+    BrkDialog* dialog = page ? page.openDialog : nil;
+    if (!dialog || dialog.answered) {
+      return false;
+    }
+    NSString* text = prompt_override ? base::SysUTF16ToNSString(*prompt_override) : dialog.defaultPromptText;
+    [dialog answer:accept text:text];
+    Cancel(page);
+    return true;
+  }
+
+  void CancelDialogs(content::WebContents* web_contents, bool reset_state) override {
+    BrkWebContents* page = PageForContents(web_contents);
+    BrkDialog* dialog = page.openDialog;
+    if (!dialog) {
+      return;
+    }
+    // As Chrome's TabModalDialogManager: the page sees the dialog dismissed, and the shell's goes.
+    [dialog answer:NO text:nil];
+    page.openDialog = nil;
+    Cancel(page);
+  }
+
+ private:
+  static bool Show(content::WebContents* web_contents, BrkDialog* dialog) {
+    BrkWebContents* page = PageForContents(web_contents);
+    id<BrkCoreWebContentsDelegate> shell = page.delegate;
+    if (!page || page.openDialog || ![shell respondsToSelector:@selector(webContents:runDialog:)]) {
+      return false;
+    }
+    page.openDialog = dialog;
+    dialog.owner = page;
+    if (![shell webContents:page runDialog:dialog]) {
+      page.openDialog = nil;
+      return false;
+    }
+    return true;
+  }
+
+  static void Cancel(BrkWebContents* page) {
+    id<BrkCoreWebContentsDelegate> shell = page.delegate;
+    if ([shell respondsToSelector:@selector(webContentsCancelDialogs:)]) {
+      [shell webContentsCancelDialogs:page];
+    }
+  }
+};
+
+}  // namespace
+
+content::JavaScriptDialogManager* JavaScriptDialogManagerHook(content::WebContents* source) {
+  if (!PageForContents(source)) {
+    return nullptr;
+  }
+  static base::NoDestructor<BrkJavaScriptDialogManager> manager;
+  return manager.get();
+}
+
+}  // namespace brkcore
