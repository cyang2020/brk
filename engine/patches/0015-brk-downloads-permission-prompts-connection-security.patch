+bool OpenURLFromTabHook(content::WebContents* source, const content::OpenURLParams& params) {
+  BrkWebContents* page = source ? PageForContents(source) : nil;
+  // A link that asks for a new window (Shift+click) goes to the shell, as CEF's OnOpenURLFromTab; Chrome would open its own window.
+  // Modified clicks that ask for a tab stay Chrome's: it adds the tab to this Browser and the shell adopts it (-tabInserted:active:).
+  if (!page || params.disposition != WindowOpenDisposition::NEW_WINDOW || !params.url.is_valid()) {
+    return false;
+  }
+  NSURL* url = net::NSURLWithGURL(params.url);
+  const BOOL gesture = params.user_gesture;
+  __weak BrkWebContents* weakPage = page;
+  // Outside Chromium's OpenURL, as the tab path does.
+  dispatch_async(dispatch_get_main_queue(), ^{
+    BrkWebContents* opener = weakPage;
+    if (opener.contents) {
+      [opener.delegate webContents:opener
+                   requestsOpening:url
+                       disposition:BrkCoreDispositionNewWindow
+                       userGesture:gesture];
+    }
+  });
+  return true;
+}
