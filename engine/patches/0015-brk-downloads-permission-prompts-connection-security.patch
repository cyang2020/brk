+}  // namespace
+
+void UseShellPermissionPrompts(content::WebContents* contents) {
+  // The manager's own seam for the view it shows. Chrome's tests use it; for Brk's pages it is where Arc puts its prompt.
+  if (auto* manager = permissions::PermissionRequestManager::FromWebContents(contents)) {
+    manager->set_view_factory_for_testing(base::BindRepeating(&CreatePrompt));
+  }
+}
+
+}  // namespace brkcore
