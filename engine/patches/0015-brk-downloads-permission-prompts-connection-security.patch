+// One prompt Chromium wants shown. Chromium owns it and deletes it when the requests are settled or taken back (navigation, the page
+// closing); an answer from the shell after that is ignored.
+class BrkPermissionPrompt : public permissions::PermissionPrompt {
+ public:
+  BrkPermissionPrompt(content::WebContents* contents, Delegate* delegate) : delegate_(delegate->GetWeakPtr()) {
+    BrkCorePermissionKind kinds = 0;
+    for (const auto& request : delegate->Requests()) {
+      kinds |= KindOf(request->request_type());
+    }
+    page_ = PageForContents(contents);
+    request_ = [[BrkPermissionRequest alloc] initWithPrompt:this
+                                                   promptID:g_next_prompt_id++
+                                                      kinds:kinds
+                                                 requesting:OriginText(delegate->GetRequestingOrigin())
+                                                  embedding:OriginText(delegate->GetEmbeddingOrigin())];
+    // Chromium is inside ShowPrompt; the shell may answer at once, which would settle the requests from in there.
+    BrkPermissionRequest* request = request_;
+    __weak BrkWebContents* page = page_;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(^{
+      BrkWebContents* owner = page;
+      id<BrkCoreWebContentsDelegate> shell = owner.delegate;
+      if (!owner.contents || ![shell respondsToSelector:@selector(webContents:requestsPermission:)]) {
+        [request answer:BrkCorePermissionAnswerDismiss];
+        return;
+      }
+      [shell webContents:owner requestsPermission:request];
+    }));
+  }
+
+  ~BrkPermissionPrompt() override {
+    const bool was_answered = answered_;
+    [request_ promptGone];
+    if (was_answered) {
+      return;
+    }
+    BrkWebContents* owner = page_;
+    id<BrkCoreWebContentsDelegate> shell = owner.delegate;
+    if ([shell respondsToSelector:@selector(webContents:didDismissPermission:)]) {
+      [shell webContents:owner didDismissPermission:request_.promptID];
+    }
+  }
+
+  void Answer(BrkCorePermissionAnswer answer) {
+    if (answered_ || !delegate_) {
+      return;
+    }
+    answered_ = true;
+    // Settling the requests deletes this prompt.
+    base::WeakPtr<Delegate> delegate = delegate_;
+    switch (answer) {
+      case BrkCorePermissionAnswerAllow:
+        delegate->Accept(std::monostate());
+        break;
+      case BrkCorePermissionAnswerDeny:
+        delegate->Deny(std::monostate());
+        break;
+      case BrkCorePermissionAnswerDismiss:
+        delegate->Dismiss(std::monostate());
+        break;
+    }
+  }
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override { return kKeepPromptAlive; }
+  permissions::PermissionPromptDisposition GetPromptDisposition() const override {
+    return permissions::PermissionPromptDisposition::ANCHORED_BUBBLE;
+  }
+  bool IsAskPrompt() const override { return true; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override { return std::nullopt; }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants() const override { return {}; }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition> GetPromptPosition() const override {
+    return std::nullopt;
+  }
+
+ private:
+  base::WeakPtr<Delegate> delegate_;
+  __weak BrkWebContents* page_;
+  BrkPermissionRequest* request_;
+  bool answered_ = false;
+};
+
+namespace {
+
+std::unique_ptr<permissions::PermissionPrompt> CreatePrompt(content::WebContents* contents,
+                                                            permissions::PermissionPrompt::Delegate* delegate) {
+  return std::make_unique<BrkPermissionPrompt>(contents, delegate);
+}
