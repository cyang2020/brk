+@implementation BrkPermissionRequest {
+  raw_ptr<brkcore::BrkPermissionPrompt> _prompt;
+  uint64_t _promptID;
+  BrkCorePermissionKind _kinds;
+  NSString* _requesting;
+  NSString* _embedding;
+}
+
+- (instancetype)initWithPrompt:(brkcore::BrkPermissionPrompt*)prompt
+                      promptID:(uint64_t)promptID
+                         kinds:(BrkCorePermissionKind)kinds
+                    requesting:(NSString*)requesting
+                     embedding:(NSString*)embedding {
+  if ((self = [super init])) {
+    _prompt = prompt;
+    _promptID = promptID;
+    _kinds = kinds;
+    _requesting = [requesting copy];
+    _embedding = [embedding copy];
+  }
+  return self;
+}
+
+- (uint64_t)promptID {
+  return _promptID;
+}
+
+- (BrkCorePermissionKind)kinds {
+  return _kinds;
+}
+
+- (NSString*)requestingOrigin {
+  return _requesting;
+}
+
+- (NSString*)embeddingOrigin {
+  return _embedding;
+}
+
+- (void)answer:(BrkCorePermissionAnswer)answer {
+  if (brkcore::BrkPermissionPrompt* prompt = _prompt) {
+    prompt->Answer(answer);
+  }
+}
+
+- (void)promptGone {
+  _prompt = nullptr;
+}
+
+@end
