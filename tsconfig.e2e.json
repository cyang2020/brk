{
  // Playwright harness and scenarios. Composite with only e2e and src/shared included (module-map rule 5):
  // the harness reaches the app through the test API contract in src/shared/test-api.ts, never main-side code.
  "extends": "./tsconfig.json",
  "compilerOptions": { "composite": true, "lib": ["ES2023", "DOM"], "types": ["node"] },
  "include": ["e2e", "src/shared"],
  "exclude": ["src/**/*.test.ts"]
}
