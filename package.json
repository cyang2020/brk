{
  "name": "arc-clone",
  "version": "0.0.0",
  "private": true,
  "description": "Arc-style browser built on Electron",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:docker": "bash e2e/docker-run.sh"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
